mapscripts Hoenn1_7_MapScripts {
}

script Hoenn1_7_EventScript_Skitty{
 
	trainerbattle_single(TRAINER_SKITTY, "test.", "test.")
	msgbox("test.", MSGBOX_AUTOCLOSE) 
	waitmessage
    end
 
}


script Hoenn1_7_EventScript_BirchBag{
 
    lockall
    playse(SE_CLICK)
    fadescreen(FADE_TO_BLACK)
    setvar(VAR_0x8000, 0)
    special(LoadBirchBagPoolById)
    special(ChooseBirchBagPokemonWeighted)
    waitstate
    
    removeobject(HOENN1_7_BIRCHBAG)
    setflag(FLAG_BIRCHBAG_1_7)
    playfanfare(MUS_EVOLVED)
    msgbox("You received a\n{STR_VAR_1}!")

    waitmessage
    releaseall
    end
 
}