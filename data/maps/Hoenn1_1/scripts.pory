mapscripts Hoenn1_1_MapScripts {
    MAP_SCRIPT_ON_LOAD: Hoenn1_1_OnLoad
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE[ VAR_TEMP_1, 0: Hoenn1_1_ONWARP]
    MAP_SCRIPT_ON_FRAME_TABLE[ VAR_TEMP_2, 0: Hoenn1_1_ONFRAME]
}

script Hoenn1_1_ONWARP {
    setvar(VAR_TEMP_1, 1)
    turnobject(LOCALID_PLAYER, DIR_EAST)
}

script Hoenn1_1_ONFRAME {
	setvar(VAR_TEMP_2, 1)
}

script Hoenn1_1_OnLoad{
    setvar(VAR_CURRENT_ACT, 1)
    special(UpdateLevelCap)
}


script Hoenn1_1_EventScript_Pokeball{
 
    lockall

    playse(SE_CLICK)
    fadescreen(FADE_TO_BLACK)
    setvar(VAR_0x8000, 0)
    special(LoadBirchBagPoolById)
    special(ChooseBirchBagPokemonWeighted)
    waitstate
    
    removeobject(HOENN1_1_BIRCHBAG)
    setflag(FLAG_BIRCHBAG_1_1)
    playfanfare(MUS_EVOLVED)
    msgbox("You received a\n{STR_VAR_1}!")

    waitmessage
    releaseall
    end
 
}


script Hoenn1_2_EventScript_Zigzagoon{
 
	trainerbattle_single(TRAINER_ZIGZAGOON, Zigzagoon_Intro, Zigzagoon_Outro)
	msgbox(PostBattle_Zigzagoon, MSGBOX_AUTOCLOSE) 
	waitmessage
    end
 
}
 
text Zigzagoon_Intro{
    "I'm Zigzagoon. I like to go in zigzags."
}
 
text Zigzagoon_Outro{
    "Zagoon :("
}
 
text PostBattle_Zigzagoon{
    "Goon Goon!"
}

