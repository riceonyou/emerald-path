script Hoenn1_1_Itemball_1{
    lockall
    giveitem(ITEM_ORAN_BERRY, 10)
    removeobject(HOENN1_1_ITEM)
    setflag(FLAG_ITEM_1_1)
    releaseall
    end
}

script Hoenn1_1_Itemball_2{
    lockall
    giveitem(ITEM_LUM_BERRY, 5)
    removeobject(HOENN1_2_ITEM)
    setflag(FLAG_ITEM_1_2)
    releaseall
    end
}