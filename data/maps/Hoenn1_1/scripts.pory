mapscripts Hoenn1_1_MapScripts {
    MAP_SCRIPT_ON_FRAME_TABLE[ VAR_TEMP_1, 0: Hoenn1_1_ONFRAME]
}

script Hoenn1_1_ONFRAME {
    setvar(VAR_TEMP_1, 1)
    call(AfterWarpIntoNewAct)
}

script Hoenn1_1_EventScript_BirchBag{
 
    lockall

    call(Act1BirchBag)
    
    removeobject(HOENN1_1_BIRCHBAG)
    setflag(FLAG_BIRCHBAG_1_1)
    

    waitmessage
    releaseall
    end
 
}


script Hoenn1_2_EventScript_Zigzagoon{
	trainerbattle_single(TRAINER_ZIGZAGOON, Zigzagoon_Intro, Zigzagoon_Outro)
	msgbox(PostBattle_Zigzagoon, MSGBOX_AUTOCLOSE) 
	waitmessage
    end
}
 
text Zigzagoon_Intro{
    "I'm Zigzagoon. I like to go in zigzags."
}
 
text Zigzagoon_Outro{
    format("You beat me :(\pDon't worry about healing your pokemon though. They get automatically healed after every fight.")
}
 
text PostBattle_Zigzagoon{
    "Goon Goon!"
}

