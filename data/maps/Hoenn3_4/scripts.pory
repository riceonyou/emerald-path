mapscripts Hoenn3_4_MapScripts {
}

script Hoenn3_4_Lunatone{
	trainerbattle_double(TRAINER_SOLROCKLUNATONE, "test", format("test"), format("test"))
	msgbox(format("test"), MSGBOX_AUTOCLOSE) 
	waitmessage
    end
}

script Hoenn3_4_Solrock{
	trainerbattle_double(TRAINER_SOLROCKLUNATONE, "test", format("test"), format("test"))
	msgbox(format("test"), MSGBOX_AUTOCLOSE) 
	waitmessage
    end
}

script Hoenn3_4_Whiscash{
	trainerbattle_single(TRAINER_WHISCASH, format("test"), format("test"))
	msgbox(format("test"), MSGBOX_AUTOCLOSE) 
	waitmessage
    end
}

script Hoenn3_Itemball_6{
    lockall
    call(GiveUncommonItem)
    removeobject(Hoenn3_Ball6)
    setflag(FLAG_ITEM_3_6)
    releaseall
    end
}

