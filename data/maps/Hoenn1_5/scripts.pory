mapscripts Hoenn1_5_MapScripts {
}

script Hoenn1_5_EventScript_Oddish{
 
	trainerbattle_single(TRAINER_ODDISH, "Hello.", "Goodbye.")
	msgbox("Hello again.", MSGBOX_AUTOCLOSE) 
	waitmessage
    end
 
}

script Hoenn1_5_EventScript_Wurmple{
 
	trainerbattle_single(TRAINER_WURMPLE, "I'm just a wurm.", "That was a good battle.")
	msgbox("Don't talk to me right now.", MSGBOX_AUTOCLOSE) 
	waitmessage
    end
 
}

script Hoenn1_5_EventScript_Slakoth{
 
	trainerbattle_single(TRAINER_SLAKOTH, "I'm just a wurm.", "That was a good battle.")
	msgbox("Don't talk to me right now.", MSGBOX_AUTOCLOSE) 
	waitmessage
    end
 
}

script Hoenn1_5_EventScript_BirchBag{

    lockall
    playse(SE_CLICK)
    fadescreen(FADE_TO_BLACK)
    setvar(VAR_0x8000, 4)
    special(LoadBirchBagPoolById)
    special(ChooseBirchBagPokemonWeighted)
    waitstate
	
    
    removeobject(HOENN1_5_BIRCHBAG)
    setflag(FLAG_BIRCHBAG_1_5)
    playfanfare(MUS_EVOLVED)
    msgbox("You received a\n{STR_VAR_1}!")

    waitmessage
    releaseall
    end
 
}