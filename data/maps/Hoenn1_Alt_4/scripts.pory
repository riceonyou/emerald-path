script Hoenn1_Alt_4_EventScript_Trapinch{
	trainerbattle_single(TRAINER_TRAPINCH, format("test"), format("test"))
	msgbox(format("test"), MSGBOX_AUTOCLOSE) 
	waitmessage
    end
}

