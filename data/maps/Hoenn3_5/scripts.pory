mapscripts Hoenn3_5_MapScripts {
}

script Hoenn3_5_Cradily{
	trainerbattle_single(TRAINER_CRADILY, format("Fossil pokemon in this game evolve at level 32, after the second path. It might feel a bit late but they got buffs to compensate!"), format("Chuuu."))
	msgbox(format("All fossil pokemon also have an ability like shell armor or battle armor that stops critical hits."), MSGBOX_AUTOCLOSE) 
	waitmessage
    end
}

script Hoenn3_5_Armaldo{
	trainerbattle_single(TRAINER_ARMALDO, format("Hi. I'm Armando the Armaldo. It's a pleasure to meet you."), format("Well played."))
	msgbox(format("Check out this watch. It cost me an armando leg.\lHaha. Get it?"), MSGBOX_AUTOCLOSE) 
	waitmessage
    end
}

script Hoenn3_5_Linoone{
	trainerbattle_single(TRAINER_LINOONE, format("Don't think I can't put up a fight just because Obstagoon is stronger than me, linoone!"), format("Noone linoone :("))
	msgbox(format("Linoone noone noone.\pSomeone, anyone."), MSGBOX_AUTOCLOSE) 
	waitmessage
    end
}

script Hoenn3_5_Rival{
    call(RivalFight3)
}

script Hoenn3_6_EventScript_BirchBag{
 
    lockall
    call(Act3BirchBag)
    
    removeobject(HOENN3_6_BIRCHBAG)
    setflag(FLAG_BIRCHBAG_3_6)
    

    waitmessage
    releaseall
    end
    
}

script Hoenn3_7_EventScript_BirchBag{
 
    lockall
    call(Act3BirchBag)
    
    removeobject(HOENN3_7_BIRCHBAG)
    setflag(FLAG_BIRCHBAG_3_7)
    

    waitmessage
    releaseall
    end
    
}