mapscripts Hoenn3_5_MapScripts {
}

script Hoenn3_5_Cradily{
	trainerbattle_single(TRAINER_CRADILY, format("test"), format("test"))
	msgbox(format("test"), MSGBOX_AUTOCLOSE) 
	waitmessage
    end
}

