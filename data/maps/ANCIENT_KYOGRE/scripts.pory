mapscripts ANCIENT_KYOGRE_MapScripts {
}

script ANCIENT_KYOGRE_EventScript_Kyogre{
    lockall 

    //GIVE ANCIENT REWARD
    msgbox("Take a pokemon with you!")
    waitmessage
    fadescreen(FADE_TO_BLACK)
    setvar(VAR_0x8000, 29)
    special(LoadBirchBagPoolById)
    special(ChooseBirchBagPokemonWeighted)
    waitstate
    playfanfare(MUS_EVOLVED)
    msgbox("You received a\n{STR_VAR_1}!")
    waitmessage

    
    msgbox("The level cap has been raised to 42")
    addvar(VAR_CURRENT_ACT, 1)
    special(UpdateLevelCap)
    msgbox("Boop beep boop.\lNow time to get you to the next\nstage.")
    //TELEPORT TO NEXT STAGE
    special(WarpToNextAct)
    releaseall
}
