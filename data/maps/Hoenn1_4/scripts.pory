mapscripts Hoenn1_4_MapScripts {
}

script Hoenn1_4_EventScript_Wingull{
 
	trainerbattle_single(TRAINER_WINGULL, "Howdy. I'm wingull. Let's battle!", "More like losegull. Squawk :(")
	msgbox("Check out this cool flying trick!", MSGBOX_AUTOCLOSE) 
	waitmessage
    end
 
}

script Hoenn1_4_EventScript_Seedot{
 
	trainerbattle_single(TRAINER_SEEDOT, "Howdy. I'm wingull. Let's battle!", "More like losegull. Squawk :(")
	msgbox("Check out this cool flying trick!", MSGBOX_AUTOCLOSE) 
	waitmessage
    end
 
}

script Hoenn1_4_EventScript_BirchBag{
 
    lockall
    playse(SE_CLICK)
    fadescreen(FADE_TO_BLACK)
    setvar(VAR_0x8000, 3)
    special(LoadBirchBagPoolById)
    special(ChooseBirchBagPokemonWeighted)
    waitstate
	
    
    removeobject(HOENN1_4_BIRCHBAG)
    setflag(FLAG_BIRCHBAG_1_4)
    playfanfare(MUS_EVOLVED)
    msgbox("You received a\n{STR_VAR_1}!")

    waitmessage
    releaseall
    end
 
}