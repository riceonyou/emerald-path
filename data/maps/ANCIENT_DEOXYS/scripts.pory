mapscripts ANCIENT_DEOXYS_MapScripts {
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE[ VAR_TEMP_1, 0: ANCIENT_DEOXYS_ONWARP]
    MAP_SCRIPT_ON_LOAD: ANCIENT_DEOXYS_LOAD_DEOXYS
}


script ANCIENT_DEOXYS_ONWARP {
    setvar(VAR_TEMP_1, 1)
    turnobject(LOCALID_PLAYER, DIR_NORTH)
    }

script ANCIENT_DEOXYS_LOAD_DEOXYS{
    switch (var(VAR_0x8000)) {
        case 0:
            setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_SPECIES(DEOXYS_ATTACK))
        case 1:
            setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_SPECIES(DEOXYS_DEFENSE))
        case 2:
            setvar(VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_SPECIES(DEOXYS_SPEED))
    }
}

script ANCIENT_DEOXYS_EventScript_TalkToDeoxys{
    lockall
    faceplayer
    //GIVE ANCIENT REWARD
    switch (var(VAR_0x8000)) {
        case 0:
            playmoncry(SPECIES_DEOXYS_ATTACK, CRY_MODE_ENCOUNTER)
            waitmoncry
            msgbox(format("Hello. I am Deoxys. This is outer space. I have some rewards for thee. Firstly an offensive pokemon."))
            waitmessage
            fadescreen(FADE_TO_BLACK)
            setvar(VAR_0x8000, 40)
            special(LoadBirchBagPoolById)
            special(ChooseBirchBagPokemonWeighted)
            waitstate
            playfanfare(MUS_EVOLVED)
	        msgbox("You received a\n{STR_VAR_1}!")
            msgbox("And secondly, a strong TM!")
            giveitem(ITEM_TM_PHOTON_GEYSER, 1)
            
            
        case 1:
            playmoncry(SPECIES_DEOXYS_DEFENSE, CRY_MODE_ENCOUNTER)
            waitmoncry
            msgbox(format("Hello. I am Deoxys. This is outer space. I have some rewards for thee. Firstly a defensive pokemon."))
            waitmessage
            fadescreen(FADE_TO_BLACK)
            setvar(VAR_0x8000, 41)
            special(LoadBirchBagPoolById)
            special(ChooseBirchBagPokemonWeighted)
            waitstate
            playfanfare(MUS_EVOLVED)
	        msgbox("You received a\n{STR_VAR_1}!")
            msgbox("And secondly, a strong TM!")
            giveitem(ITEM_TM_SILK_TRAP, 1)
            

        case 2:
            playmoncry(SPECIES_DEOXYS_SPEED, CRY_MODE_ENCOUNTER)
            waitmoncry
            msgbox(format("Hello. I am Deoxys. This is outer space. I have some rewards for thee. Firstly a speedy pokemon."))
            waitmessage
            fadescreen(FADE_TO_BLACK)
            setvar(VAR_0x8000, 42)
            special(LoadBirchBagPoolById)
            special(ChooseBirchBagPokemonWeighted)
            waitstate
            playfanfare(MUS_EVOLVED)
	        msgbox("You received a\n{STR_VAR_1}!")
            msgbox("And secondly, a strong TM!")
            giveitem(ITEM_TM_EXTREME_SPEED, 1)
    }
    waitmessage
    msgbox(format("And lastly, a charm for you."))
    waitmessage
    giveitem(ITEM_DEOXYS_MUTATION_CHARM, 1)
    msgbox(format("The Deoxys Mutation causes your pokemon to boost a random stat every other turn. I hope it provides you the boost needed to defeat the next and final path, haha.\pNow off you go."))
    //TELEPORT TO NEXT STAGE
    special(WarpToNextAct)
    
    releaseall
}