mapscripts Hoenn3_1_MapScripts {
    MAP_SCRIPT_ON_FRAME_TABLE[ VAR_TEMP_1, 0: Hoenn3_1_ONFRAME]
}

script Hoenn3_1_ONFRAME {
    setvar(VAR_TEMP_1, 1)
    call(AfterWarpIntoNewAct)
}

script Hoenn3_1_Vibrava{
	trainerbattle_single(TRAINER_FLYGON, "test", "test")
	msgbox("test", MSGBOX_AUTOCLOSE) 
	waitmessage
    end
}

script Hoenn3_1_Cacturne{
