script Hoenn3_1_EventScript_BirchBag{
 
    lockall
    call(Act3BirchBag)
    
    removeobject(HOENN3_1_BIRCHBAG)
    setflag(FLAG_BIRCHBAG_3_1)
    

    waitmessage
    releaseall
    end
    
}

script Hoenn3_5_EventScript_BirchBag{
 
    lockall
    call(Act3BirchBag)
    
    removeobject(HOENN3_5_BIRCHBAG)
    setflag(FLAG_BIRCHBAG_3_5)
    

    waitmessage
    releaseall
    end
    
}