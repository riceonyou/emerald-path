mapscripts ANCIENT_MANAPHY_MapScripts {
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE[ VAR_TEMP_1, 0: ANCIENT_MANAPHY_ONWARP]
}
script ANCIENT_MANAPHY_ONWARP {
    setvar(VAR_TEMP_1, 1)
    turnobject(LOCALID_PLAYER, DIR_NORTH)
}

script ANCIENT_MANAPHY_EventScript_TalkToManaphy{
    lockall

    //GIVE ANCIENT REWARD
    msgbox("Take a water pokemon with you!")
    waitmessage
    fadescreen(FADE_TO_BLACK)
    setvar(VAR_0x8000, 29)
    special(LoadBirchBagPoolById)
    special(ChooseBirchBagPokemonWeighted)
    waitstate
    playfanfare(MUS_EVOLVED)
    msgbox("You received a\n{STR_VAR_1}!")

    waitmessage
    msgbox("The level cap has been raised to 30")
    special(UpdateLevelCap)
    msgbox("Boop beep boop.\lNow time to get you to the next\nstage.")
    //TELEPORT TO NEXT STAGE
    special(WarpToNextAct)
    releaseall
}