mapscripts ANCIENT_MANAPHY_MapScripts {
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE[ VAR_TEMP_1, 0: ANCIENT_MANAPHY_ONWARP]
}
script ANCIENT_MANAPHY_ONWARP {
    setvar(VAR_TEMP_1, 1)
    turnobject(LOCALID_PLAYER, DIR_NORTH)
}

script ANCIENT_MANAPHY_EventScript_TalkToManaphy{
    lockall
    faceplayer
    //GIVE ANCIENT REWARD
    playmoncry(SPECIES_MANAPHY, CRY_MODE_ENCOUNTER)
    waitmoncry
    msgbox("Heya!\nGood job on beating the first path!\lI've got a bunch of goodies to give you!\nHere's a water pokemon!")
    waitmessage
    fadescreen(FADE_TO_BLACK)
    setvar(VAR_0x8000, 29)
    special(LoadBirchBagPoolById)
    special(ChooseBirchBagPokemonWeighted)
    waitstate
    playfanfare(MUS_EVOLVED)
	msgbox("You received a\n{STR_VAR_1}!")
    waitfanfare
    msgbox("And a Liquidation TM!")
    giveitem(ITEM_TM_LIQUIDATION, 1)
    waitmessage
    msgbox("And a Phione Egg!\lThe egg will hatch into a phione\nafter you complete the next act!\nPhione is a great rain pokemon!")
    giveitem(ITEM_PHIONE_EGG_CHARM, 1)
    waitmessage

    msgbox("That's all from me!\lNow lets get ya to the next path!")
    applymovement(1, moves(
        jump_in_place_left_right
    ))
    waitmovement
    playmoncry(SPECIES_MANAPHY, CRY_MODE_ENCOUNTER)
    waitmoncry
    //TELEPORT TO NEXT STAGE
    special(WarpToNextAct)
    releaseall
}