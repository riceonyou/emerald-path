							msgbox("I'm sorry. You don't have the money to\nadopt that pokemon.")
						}
					case SPECIES_QUAXLY:
						if(checkmoney(5000)){
							setflag(FLAG_QUAXLY_UNLOCKED)
							removemoney(5000)
							updatemoneybox
							playse(SE_SHOP)
							msgbox("You unlocked Quaxly as a starter!\pThank you for your adoption!")
						}
						else{
							msgbox("I'm sorry. You don't have the money to\nadopt that pokemon.")
						}
				}
		hidemoneybox
		releaseall
	}else{
		msgbox("You have no more starters left\nto adopt!")
		waitmessage
		releaseall
	}

}

script Hub_Event_Script_Chansey{
