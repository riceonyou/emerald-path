script KecShop {
    lockall
    msgbox("Welcome to the Kecleon Brother's shop!")
	if(flag(FLAG_MEMORY_MUSHROOM_UNLOCKED)){
		dynmultipush("Mem. Mushroom (¥200)",ITEM_MEMORY_MUSHROOM)
		addvar(VAR_TEMP_A, 1)
	}
	if(flag(FLAG_RARE_CANDY_UNLOCKED)){
		dynmultipush("Rare Candy (¥2000)",ITEM_RARE_CANDY)
		addvar(VAR_TEMP_A, 1)
	}
	if(flag(FLAG_ORAN_BERRY_UNLOCKED)){
		dynmultipush("Oran Berry (¥200)",ITEM_ORAN_BERRY)
		addvar(VAR_TEMP_A, 1)
	}
	if(flag(FLAG_LUM_BERRY_UNLOCKED)){
		dynmultipush("Lum Berry (¥500)",ITEM_LUM_BERRY)
		addvar(VAR_TEMP_A, 1)
	}
	if(flag(FLAG_SERIOUS_MINT_UNLOCKED)){
		dynmultipush("Serious Mint (¥2000)",ITEM_SERIOUS_MINT)
		addvar(VAR_TEMP_A, 1)
	}

	if(var(VAR_TEMP_A) != 0){
		showmoneybox(18, 10)
		dynmultistack(0, 0, FALSE, 6, FALSE, 0, DYN_MULTICHOICE_CB_SHOW_ITEM)
		switch(var(VAR_RESULT)){
			case ITEM_ORAN_BERRY:
				if(checkmoney(200)){
					removemoney(200)
					updatemoneybox
					playse(SE_SHOP)
					giveitem(ITEM_ORAN_BERRY)
					msgbox("Thank you for your purchase!")
				}
				else{
					msgbox("I'm sorry. You don't have the money to\nbuy that, kec.")
				}
			case ITEM_LUM_BERRY:
				if(checkmoney(200)){
					removemoney(200)
					updatemoneybox
					playse(SE_SHOP)
					giveitem(ITEM_LUM_BERRY)
					msgbox("Thank you for your purchase!")
				}
				else{
					msgbox("I'm sorry. You don't have the money to\nbuy that, kec.")
				}
			case ITEM_SERIOUS_MINT:
				if(checkmoney(200)){
					removemoney(200)
					updatemoneybox
					playse(SE_SHOP)
					giveitem(ITEM_SERIOUS_MINT)
					msgbox("Thank you for your purchase!")
				}
				else{
					msgbox("I'm sorry. You don't have the money to\nbuy that, kec.")
				}
			case ITEM_MEMORY_MUSHROOM:
				if(checkmoney(200)){
					removemoney(200)
					updatemoneybox
					playse(SE_SHOP)
					giveitem(ITEM_MEMORY_MUSHROOM)
					msgbox("Thank you for your purchase!")
				}
				else{
					msgbox("I'm sorry. You don't have the money to\nbuy that, kec.")
				}
			case ITEM_RARE_CANDY:
				if(checkmoney(200)){
					removemoney(200)
					updatemoneybox
					playse(SE_SHOP)
					giveitem(ITEM_RARE_CANDY)
					msgbox("Thank you for your purchase!")
				}
				else{
					msgbox("I'm sorry. You don't have the money to\nbuy that, kec.")
				}
		}
		hidemoneybox	
	}else{
		msgbox("Sorry, but there's nothing for you\nto buy right now, Kec.")
		waitmessage
		releaseall}
	
	releaseall
}

