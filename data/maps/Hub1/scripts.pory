mapscripts Hub1_MapScripts {
	MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE[ VAR_TEMP_1, 0: HUB1_ONWARP]
	MAP_SCRIPT_ON_FRAME_TABLE[ VAR_TEMP_2, 0: HUB1_ONFRAME]
}

//-----------------------------------GLOBAL SCRIPTS THAT ARE USED A BUNCH----------------------------------------------------------
script AfterWarpIntoNewAct{
    
	if(flag(FLAG_HOOH_FEATHER_USED)){
		msgbox(format("Your Ho-Oh Feather activated! You were given another chance!"))
		clearflag(FLAG_HOOH_FEATHER_USED)
		releaseall
	}

	if(!flag(FLAG_WARPED_INTO_NEW_ACT)){
		setflag(FLAG_WARPED_INTO_NEW_ACT)

        //Play Phione egg message
        if (flag(FLAG_PHIONE_EGG_HATCHED)){
            removeitem(ITEM_PHIONE_EGG_CHARM, 1)
			setvar(VAR_RESULT, SPECIES_PHIONE)
			special(GiveBufferedMon)
			playfanfare(MUS_EVOLVED)
			clearflag(FLAG_PHIONE_EGG_HATCHED)
			msgbox("Your Phione egg hatched into a Phione!")
        }

		//Give Minty Charm Mint
        if (flag(FLAG_GIVE_MINTY_CHARM_MINT)){
			msgbox("Your Minty Charm activated!")
			randomelement(ITEM_LONELY_MINT, ITEM_ADAMANT_MINT, ITEM_NAUGHTY_MINT, ITEM_BRAVE_MINT, ITEM_BOLD_MINT, ITEM_IMPISH_MINT, ITEM_LAX_MINT, ITEM_RELAXED_MINT, ITEM_MODEST_MINT, ITEM_MILD_MINT, ITEM_RASH_MINT, ITEM_QUIET_MINT, ITEM_CALM_MINT, ITEM_GENTLE_MINT, ITEM_CAREFUL_MINT, ITEM_SASSY_MINT, ITEM_SERIOUS_MINT)
			giveitem(VAR_RESULT)
			clearflag(FLAG_GIVE_MINTY_CHARM_MINT)
        }

		//Announce level cap updated
		if(var(VAR_CURRENT_ACT) > 1){
			playfanfare(MUS_OBTAIN_ITEM)
			buffernumberstring(STR_VAR_1, VAR_LEVEL_CAP)
			msgbox(format("The level cap has been raised to {STR_VAR_1}!\pYou can level your pokemon up to the cap via the party menu."))
		}


		//Hub stuff
		if (var(VAR_CURRENT_ACT) == 0){
			
			if(var(VAR_COINS_COLLECTED_IN_A_RUN) > 0){
				buffernumberstring(STR_VAR_1, VAR_COINS_COLLECTED_IN_A_RUN)
				msgbox("You managed to collect\n{STR_VAR_1} COINS in your last run!")
				setvar(VAR_COINS_COLLECTED_IN_A_RUN, 0)
			}

			//UNLOCKS
			//starter charms
			if((!flag(FLAG_MINTY_CHARM_STARTER_UNLOCKED)) && (var(VAR_TOTAL_RUNS) > 0)){
				setflag(FLAG_MINTY_CHARM_STARTER_UNLOCKED)
				msgbox(format("You've unlocked the Minty Charm as a starter charm!"))
			}
			if((!flag(FLAG_TINTED_CHARM_STARTER_UNLOCKED)) && (var(VAR_TOTAL_RUNS) > 3)){
				setflag(FLAG_TINTED_CHARM_STARTER_UNLOCKED)
				msgbox(format("You've unlocked the Tinted Charm as a starter charm!"))
			}
			if((!flag(FLAG_NORMAL_CHARM_STARTER_UNLOCKED)) && (var(VAR_TOTAL_RUNS) > 6)){
				setflag(FLAG_NORMAL_CHARM_STARTER_UNLOCKED)
				msgbox(format("You've unlocked the Normal Charm as a starter charm!"))
			}
			//difficulty
			if(flag(FLAG_NEW_DIFFICULTY_UNLOCKED)){
				msgbox(format("You've unlocked a new difficulty!"))
				clearflag(FLAG_NEW_DIFFICULTY_UNLOCKED)
			}
			//new alt path
			if((!flag(FLAG_HOENN1_ALT_UNLOCKED)) && (var(VAR_ACT1_WINS) > 1)){
				setflag(FLAG_HOENN1_ALT_UNLOCKED)
				msgbox(format("You've unlocked an alternate first path! Each time you enter a path, you now have a chance to enter the alternate path."))
			}
		}
		releaseall
    }
	
}

script GiveCommonItem{
	special(BufferCommonItem)
	giveitem(VAR_RESULT)
}

script GiveUncommonItem{
	special(BufferUncommonItem)
	giveitem(VAR_RESULT)
}

script GiveRareItem{
	special(BufferRareItem)
	giveitem(VAR_RESULT)
}

script Act1BirchBag{
	playse(SE_CLICK)
    fadescreen(FADE_TO_BLACK)
    setvar(VAR_0x8000, 33)
    special(LoadBirchBagPoolById)
    special(ChooseBirchBagPokemonWeighted)
	waitstate
	playfanfare(MUS_EVOLVED)
	msgbox("You received a\n{STR_VAR_1}!")
}
