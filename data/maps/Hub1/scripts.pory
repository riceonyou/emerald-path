				givemon(SPECIES_POPPLIO, 14)
				setflag(FLAG_POPPLIO_UNLOCKED)
				setvar(VAR_STARTER_MON, SPECIES_POPPLIO)
			case SPECIES_GROOKEY:
				givemon(SPECIES_GROOKEY, 14)
				setflag(FLAG_GROOKEY_UNLOCKED)
				setvar(VAR_STARTER_MON, SPECIES_GROOKEY)
			case SPECIES_SCORBUNNY:
				givemon(SPECIES_SCORBUNNY, 14)
				setflag(FLAG_SCORBUNNY_UNLOCKED)
				setvar(VAR_STARTER_MON, SPECIES_SCORBUNNY)
			case SPECIES_SOBBLE:
				givemon(SPECIES_SOBBLE, 14)
				setflag(FLAG_SOBBLE_UNLOCKED)
				setvar(VAR_STARTER_MON, SPECIES_SOBBLE)
			case SPECIES_SPRIGATITO:
				givemon(SPECIES_SPRIGATITO, 14)
				setflag(FLAG_SPRIGATITO_UNLOCKED)
				setvar(VAR_STARTER_MON, SPECIES_SPRIGATITO)
			case SPECIES_FUECOCO:
				givemon(SPECIES_FUECOCO, 14)
				setflag(FLAG_FUECOCO_UNLOCKED)
				setvar(VAR_STARTER_MON, SPECIES_FUECOCO)
			case SPECIES_QUAXLY:
				givemon(SPECIES_QUAXLY, 14)
				setflag(FLAG_QUAXLY_UNLOCKED)
				setvar(VAR_STARTER_MON, SPECIES_QUAXLY)
		}
		
		special(UpdateTransformedPlayerPalette)
		special(UpdatePlayerSprite)
		releaseall

		lockall
		// msgbox("Use this item to level up your\nPokemon.")
		// giveitem(ITEM_CANDY_JAR)
		msgbox(format("Nice choice!\pNow for an introduction...\pThis area is the Hub.\nYou start every run and end every run here.\pIn the hub, you can unlock new starter pokemon, new shop items, and more.\pTo start a run, talk to professor Birch above you.\pEach run, you must go through paths, collecting pokemon, gathering items and battling trainers.\pThat's the gist of it.\pNow go ahead and start a run when you're ready!"))	

		releaseall
	}
}

script Hub_Event_Script_Birch{
    lockall
	faceplayer
	backtomain:
	messageinstant("What would you like to do?")
	dynmultichoice(0, 0, FALSE, 5, 0, DYN_MULTICHOICE_CB_NONE, "Start a run", "Change the difficulty")
	closemessage
	switch(var(VAR_RESULT)){
		case MULTI_B_PRESSED:
			msgbox(format("Let me know when you're ready to start a run!"))
			releaseall
			end
		case 0:
			msgbox("Would you like to start a run?", MSGBOX_YESNO)
				switch (var(VAR_RESULT)) {
					case YES:
						msgbox("Alright then!")
						closemessage
						applymovement(Chimecho, moves(
							walk_down
							face_left
						))
						waitmovement
						msgbox(format("Don't forget to take a starter charm with you!"))
						call(GiveStarterCharm)
						msgbox("Now off you go! Good luck!")
						closemessage
						applymovement(Birch, moves(
							walk_up
							walk_left
							face_right
						))
						waitmovement
						applymovement(LOCALID_PLAYER, moves(
							walk_up * 4
						))
						waitmovement
						special(WarpToNextAct)
					case NO:
						msgbox("Okay! Let me know when you're ready.")
						releaseall
				}
			
		case 1:
			buffernumberstring(STR_VAR_1, VAR_CURRENT_DIFFICULTY)
			messageinstant("Current difficulty: {STR_VAR_1}\nNote the modifiers stack at each level.")
			dynmultipush("0 - No modifiers", 0)
			if(var(VAR_UNLOCKED_DIFFICULTY) > 0){dynmultipush("1 - +1 Enemies Level", 1)}
			if(var(VAR_UNLOCKED_DIFFICULTY) > 1){dynmultipush("2 - -1 Birch Bag each path", 2)}
			if(var(VAR_UNLOCKED_DIFFICULTY) > 2){dynmultipush("3 - Less Money", 3)}
			if(var(VAR_UNLOCKED_DIFFICULTY) > 3){dynmultipush("4 - Enemies crit more", 4)}
			if(var(VAR_UNLOCKED_DIFFICULTY) > 4){dynmultipush("5 - +1 Enemies Level", 5)}
			if(var(VAR_UNLOCKED_DIFFICULTY) > 5){dynmultipush("6 - -1 Birch Bag each path", 6)}
			dynmultistack(0, 0, FALSE, 6, FALSE, 0, DYN_MULTICHOICE_CB_NONE)
			closemessage
			switch(var(VAR_RESULT)){
				case MULTI_B_PRESSED:
					msgbox(format("Beat all 4 paths to unlock the next difficulty!"))
					goto(backtomain)
				case 0:
				case 1:
				case 2:
				case 3:
				case 4:
				case 5:
				case 6:
					buffernumberstring(STR_VAR_1, VAR_RESULT)
					copyvar(VAR_CURRENT_DIFFICULTY, VAR_RESULT)
					msgbox("Difficulty set to {STR_VAR_1}")
					goto(backtomain)

			}
	}
}

