				setflag(FLAG_ROWLET_UNLOCKED)
				setvar(VAR_STARTER_MON, SPECIES_ROWLET)
			case SPECIES_LITTEN:
				givemon(SPECIES_LITTEN, 5)
				setflag(FLAG_LITTEN_UNLOCKED)
				setvar(VAR_STARTER_MON, SPECIES_LITTEN)
			case SPECIES_POPPLIO:
