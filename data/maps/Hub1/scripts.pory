mapscripts Hub1_MapScripts {
	MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE[ VAR_TEMP_1, 0: HUB1_ONWARP]
	MAP_SCRIPT_ON_FRAME_TABLE[ VAR_TEMP_2, 0: HUB1_ONFRAME]
}

//-----------------------------------GLOBAL SCRIPTS THAT ARE USED A BUNCH----------------------------------------------------------
script AfterWarpIntoNewAct{
    
	if(!flag(FLAG_WARPED_INTO_NEW_ACT)){
		setflag(FLAG_WARPED_INTO_NEW_ACT)

        //Play Phione egg message
        if (flag(FLAG_PHIONE_EGG_HATCHED)){
            removeitem(ITEM_PHIONE_EGG_CHARM, 1)
			setvar(VAR_RESULT, SPECIES_PHIONE)
			special(GiveBufferedMon)
			playfanfare(MUS_EVOLVED)
			clearflag(FLAG_PHIONE_EGG_HATCHED)
			msgbox("Your Phione egg hatched into a Phione!")
        }


		releaseall
    }
	
}

script AbraTeleport{
	lockall
	if(!flag(FLAG_DEFEATED_PATH_LEADER)){
		msgbox("You'll have to defeat the leader first\nbefore I can teleport you\lto the next act.")
		releaseall
	}
	else{
		msgbox("Would you like to teleport\nto the next act?", MSGBOX_YESNO)
		switch (var(VAR_RESULT)) {
			case YES:
				msgbox("Alright then! Here we go!")
				clearflag(FLAG_DEFEATED_PATH_LEADER)
				special(WarpToNextAncient)
			case NO:
				msgbox("Okay! Let me know when you're ready.")
				releaseall
		}
	}
}

script RivalFight1 {
	switch (var(VAR_CURRENT_RIVAL)){
        case 0:
            trainerbattle_single(TRAINER_TREECKO, "Yo I'm Treecko. Grrr.", "Damn you got me.")
            msgbox("I'll get you next time.", MSGBOX_AUTOCLOSE) 
            waitmessage
            end
        case 1:
            trainerbattle_single(TRAINER_TORCHIC, "Yo I'm Torchic. Grrr.", "Damn you got me.")
            msgbox("I'll get you next time.", MSGBOX_AUTOCLOSE) 
            waitmessage
            end
    }
}

