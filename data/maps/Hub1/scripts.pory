mapscripts Hub1_MapScripts {
	MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE[ VAR_TEMP_1, 0: HUB1_ONWARP]
	MAP_SCRIPT_ON_FRAME_TABLE[ VAR_TEMP_2, 0: HUB1_ONFRAME]
}
script AfterWarpIntoNewAct{
    
	if(!flag(FLAG_WARPED_INTO_NEW_ACT)){
		setflag(FLAG_WARPED_INTO_NEW_ACT)

        //Play Phione egg message
        if (flag(FLAG_PHIONE_EGG_HATCHED)){
            removeitem(ITEM_PHIONE_EGG_CHARM, 1)
			givemon(SPECIES_PHIONE, 42)
			playfanfare(MUS_EVOLVED)
			clearflag(FLAG_PHIONE_EGG_HATCHED)
			msgbox("Your Phione egg hatched into a Phione!")
        }

    }
}

script HUB1_Run_Stats_Sign {
    lockall

    buffernumberstring(STR_VAR_1, VAR_TOTAL_RUNS)
    buffernumberstring(STR_VAR_2, VAR_ACT1_WINS)
    buffernumberstring(STR_VAR_3, VAR_ACT2_WINS)
    msgbox("Total Runs: {STR_VAR_1}\nAct 1 Wins: {STR_VAR_2}")
    waitmessage

    buffernumberstring(STR_VAR_1, VAR_ACT3_WINS)
    buffernumberstring(STR_VAR_2, VAR_ACT4_WINS)
	buffernumberstring(STR_VAR_3, VAR_ACT2_WINS)
    msgbox("Act 2 Wins: {STR_VAR_3}\nAct 3 Wins: {STR_VAR_1}\pAct 4 Wins: {STR_VAR_2}")
    waitmessage

    releaseall
}

script HUB1_ONWARP {
    setvar(VAR_TEMP_1, 1)
}

script HUB1_ONFRAME {
	setvar(VAR_TEMP_2, 1)

	//STUFF FOR WHEN A RUN FINISHES
	setvar(VAR_CURRENT_ACT, 0)
	

	if(!flag(FLAG_SYS_NEW_GAME)){// STUFF FOR NEW GAME
		lockall

		//Set Starter Vars and Flags
		setflag(FLAG_SYS_NEW_GAME)
		setvar(VAR_SHINY_RATE, 4096)//4096 originally

		//Intro
		msgbox("Welcome to Pokemon Path!\pTo start a run, talk to\nProfessor Birch up ahead.\pNow choose a pokemon to\nstart your adventure with.")
		
		//Give starter pokemon
		dynmultipush("Bulbasaur", SPECIES_BULBASAUR)
		dynmultipush("Charmander", SPECIES_CHARMANDER)
		dynmultipush("Squirtle", SPECIES_SQUIRTLE)
		dynmultipush("Chikorita", SPECIES_CHIKORITA)
