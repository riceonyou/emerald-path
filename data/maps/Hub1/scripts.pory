	if(flag(FLAG_FROAKIE_UNLOCKED) && var(VAR_STARTER_MON) != SPECIES_FROAKIE){dynmultipush("Froakie",SPECIES_FROAKIE) addvar(VAR_TEMP_A,1)}
	if(flag(FLAG_ROWLET_UNLOCKED) && var(VAR_STARTER_MON) != SPECIES_ROWLET){dynmultipush("Rowlet",SPECIES_ROWLET) addvar(VAR_TEMP_A,1)}
	if(flag(FLAG_LITTEN_UNLOCKED) && var(VAR_STARTER_MON) != SPECIES_LITTEN){dynmultipush("Litten",SPECIES_LITTEN) addvar(VAR_TEMP_A,1)}
	if(flag(FLAG_POPPLIO_UNLOCKED) && var(VAR_STARTER_MON) != SPECIES_POPPLIO){dynmultipush("Popplio",SPECIES_POPPLIO) addvar(VAR_TEMP_A,1)}
	if(flag(FLAG_GROOKEY_UNLOCKED) && var(VAR_STARTER_MON) != SPECIES_GROOKEY){dynmultipush("Grookey",SPECIES_GROOKEY) addvar(VAR_TEMP_A,1)}
	if(flag(FLAG_SCORBUNNY_UNLOCKED) && var(VAR_STARTER_MON) != SPECIES_SCORBUNNY){dynmultipush("Scorbunny",SPECIES_SCORBUNNY) addvar(VAR_TEMP_A,1)}
	if(flag(FLAG_SOBBLE_UNLOCKED) && var(VAR_STARTER_MON) != SPECIES_SOBBLE){dynmultipush("Sobble",SPECIES_SOBBLE) addvar(VAR_TEMP_A,1)}
	if(flag(FLAG_SPRIGATITO_UNLOCKED) && var(VAR_STARTER_MON) != SPECIES_SPRIGATITO){dynmultipush("Sprigatito",SPECIES_SPRIGATITO) addvar(VAR_TEMP_A,1)}
	if(flag(FLAG_FUECOCO_UNLOCKED) && var(VAR_STARTER_MON) != SPECIES_FUECOCO){dynmultipush("Fuecoco",SPECIES_FUECOCO) addvar(VAR_TEMP_A,1)}
	if(flag(FLAG_QUAXLY_UNLOCKED) && var(VAR_STARTER_MON) != SPECIES_QUAXLY){dynmultipush("Quaxly",SPECIES_QUAXLY) addvar(VAR_TEMP_A,1)}
	
	if(var(VAR_TEMP_A) != 0){
		setvar(VAR_RESULT, 0)
		msgbox("Would you like to change your starter?")
		dynmultistack(0, 0, FALSE, 6, FALSE, 0, DYN_MULTICHOICE_CB_SHOW_MON)

		if(!(var(VAR_RESULT) == MULTI_B_PRESSED)){
			copyvar(VAR_STARTER_MON, VAR_RESULT)
			special(ZeroPlayerPartyMons)
			special(GiveSavedStarter)
			special(UpdatePlayerSprite)
			special(UpdateTransformedPlayerPalette)
			playfanfare(MUS_LEVEL_UP)
			releaseall
			lockall
			playse(SE_SUCCESS)
			msgbox("There you go!")
			waitmessage
			releaseall
		}
		else{
			releaseall
		}
	}else{
		msgbox("You don't have any starter pokemon yet.\pPlease consider adopting some pokemon\nfrom my friend Miltank to the right.")
		waitmessage
		releaseall}
}

