script Hub_Event_Script_Kecleon {
	lockall
	faceplayer
    setvar(VAR_TEMP_A, 0)
	msgbox("Hey there! Would you like me to\nstock an item?")
	if(!flag(FLAG_MEMORY_MUSHROOM_UNLOCKED)){
