					}
					else{
						msgbox("I'm sorry, but you don't have the\n coins for that right now.")
					}
			}
		}else{
			msgbox("I don't have anything on sale right now,
					sorry.

					Try doing more runs and getting far
					with new pokemon!")
			waitmessage
			releaseall}

		hidecoinsbox(0,0)
	}
	releaseall
}

script Hub_Event_Script_Chimecho {

	if(var(VAR_TOTAL_RUNS) < 3){
		msgbox("Heya. I sell starter charms.
				But I'm not open just yet.
				Try playing some more runs first, chim!")
