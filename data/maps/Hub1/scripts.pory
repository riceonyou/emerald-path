	if(!flag(FLAG_POPPLIO_UNLOCKED)){dynmultipush("Popplio (¥3000)",SPECIES_POPPLIO) addvar(VAR_TEMP_A,1)}
	if(!flag(FLAG_GROOKEY_UNLOCKED)){dynmultipush("Grookey (¥3000)",SPECIES_GROOKEY) addvar(VAR_TEMP_A,1)}
	if(!flag(FLAG_SCORBUNNY_UNLOCKED)){dynmultipush("Scorbunny (¥3000)",SPECIES_SCORBUNNY) addvar(VAR_TEMP_A,1)}
	if(!flag(FLAG_SOBBLE_UNLOCKED)){dynmultipush("Sobble (¥3000)",SPECIES_SOBBLE) addvar(VAR_TEMP_A,1)}
	if(!flag(FLAG_SPRIGATITO_UNLOCKED)){dynmultipush("Sprigatito (¥3000)",SPECIES_SPRIGATITO) addvar(VAR_TEMP_A,1)}
	if(!flag(FLAG_FUECOCO_UNLOCKED)){dynmultipush("Fuecoco (¥3000)",SPECIES_FUECOCO) addvar(VAR_TEMP_A,1)}
	if(!flag(FLAG_QUAXLY_UNLOCKED)){dynmultipush("Quaxly (¥3000)",SPECIES_QUAXLY) addvar(VAR_TEMP_A,1)}
	
	if (var(VAR_TEMP_A) != 0){
		showmoneybox(17, 10)
		msgbox("Would you like to adopt a pokemon?")
		dynmultistack(0, 0, FALSE, 6, FALSE, 0, DYN_MULTICHOICE_CB_SHOW_MON)
				switch (var(VAR_RESULT)) {
					case MULTI_B_PRESSED:
						releaseall
					case SPECIES_BULBASAUR:
						if(checkmoney(3000)){
							setflag(FLAG_BULBASAUR_UNLOCKED)
							removemoney(3000)
							updatemoneybox
							playse(SE_SHOP)
							msgbox("You unlocked Bulbasaur as a starter!\pThank you for your adoption!")
						}
						else{
							msgbox("I'm sorry. You don't have the money to\nadopt that pokemon.")
						}
					case SPECIES_CHARMANDER:
						if(checkmoney(3000)){
