script Hub_Event_Script_Diancie {
	lockall
	faceplayer
	if(!flag(FLAG_MEGA_SHOP_UNLOCKED) && !flag(FLAG_ITEM_CHARIZARDITE_X_UNLOCKED)){
		msgbox("Hey there! I'm Diancie.
				I love collecting special gems.
				I plan on selling some of them soon
				but I don't have any to sell right now.
				I hope you come visit again another
				time.")
	}
	elif(flag(FLAG_MEGA_SHOP_UNLOCKED) && !flag(FLAG_ITEM_CHARIZARDITE_X_UNLOCKED)){
		msgbox("Hiya! I've finally started selling
				some of my precious gems.
				To celebrate, I'll give you this
				one on the house!")
		giveitem(ITEM_CHARIZARDITE_X, 1)
		setflag(FLAG_ITEM_VENUSAURITE_BUYABLE)
		setflag(FLAG_ITEM_CHARIZARDITE_Y_BUYABLE)
		setflag(FLAG_ITEM_BLASTOISINITE_BUYABLE)
		setflag(FLAG_ITEM_CHARIZARDITE_X_UNLOCKED)
		msgbox("There aren't so many gems I want to,
				sell right now. But I might sell more
				in the future.")
	}
	elif(flag(FLAG_ITEM_CHARIZARDITE_X_UNLOCKED)){
		setvar(VAR_TEMP_A, 0)
		if(flag(FLAG_ITEM_VENUSAURITE_BUYABLE)){
			dynmultipush("Venusaurite (¥1000)",ITEM_VENUSAURITE)
			addvar(VAR_TEMP_A, 1)
		}
		if(flag(FLAG_ITEM_CHARIZARDITE_Y_BUYABLE)){
			dynmultipush("Charizardite Y (¥1000)",ITEM_CHARIZARDITE_Y)
			addvar(VAR_TEMP_A, 1)
		}
		if(flag(FLAG_ITEM_BLASTOISINITE_BUYABLE)){
			dynmultipush("Blastoisinite (¥1000)",ITEM_BLASTOISINITE)
			addvar(VAR_TEMP_A, 1)
		}
		if(flag(FLAG_ITEM_BEEDRILLITE_BUYABLE)){
			dynmultipush("Beedrillite (¥1000)",ITEM_BEEDRILLITE)
			addvar(VAR_TEMP_A, 1)
		}
		if(flag(FLAG_ITEM_PIDGEOTITE_BUYABLE)){
			dynmultipush("Pidgeotite (¥1000)",ITEM_PIDGEOTITE)
			addvar(VAR_TEMP_A, 1)
		}
		if(flag(FLAG_ITEM_ALAKAZITE_BUYABLE)){
			dynmultipush("Alakazite (¥1000)",ITEM_ALAKAZITE)
			addvar(VAR_TEMP_A, 1)
		}
		if(flag(FLAG_ITEM_SLOWBRONITE_BUYABLE)){
			dynmultipush("Slowbronite (¥1000)",ITEM_SLOWBRONITE)
			addvar(VAR_TEMP_A, 1)
		}
		if(flag(FLAG_ITEM_GENGARITE_BUYABLE)){
			dynmultipush("Gengarite (¥1000)",ITEM_GENGARITE)
			addvar(VAR_TEMP_A, 1)
		}
		if(flag(FLAG_ITEM_KANGASKHANITE_BUYABLE)){
			dynmultipush("Kangaskhanite (¥1000)",ITEM_KANGASKHANITE)
			addvar(VAR_TEMP_A, 1)
