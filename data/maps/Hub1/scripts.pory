script Hub_Event_Script_Kecleon {
	lockall
	faceplayer
    setvar(VAR_TEMP_A, 0)
	msgbox("Hey there! Would you like me to\nstock an item?")
	if(!flag(FLAG_RARE_CANDY_UNLOCKED)){
		dynmultipush("Rare Candy (¥2000)",ITEM_RARE_CANDY)
		addvar(VAR_TEMP_A, 1)
	}
	
	if(!flag(FLAG_LUM_BERRY_UNLOCKED)){
		dynmultipush("Lum Berry (¥500)",ITEM_LUM_BERRY)
		addvar(VAR_TEMP_A, 1)
	}

	if(!flag(FLAG_SERIOUS_MINT_UNLOCKED)){
		dynmultipush("Serious Mint (¥2000)",ITEM_SERIOUS_MINT)
		addvar(VAR_TEMP_A, 1)
	}

	if(!flag(FLAG_IV_BOTTLE_CAPS_UNLOCKED)){
		dynmultipush("Bottle Caps (¥1000)",ITEM_HP_BOTTLE_CAP)
		addvar(VAR_TEMP_A, 1)
	}

	if(!flag(FLAG_IV_GOLD_BOTTLE_CAPS_UNLOCKED)){
		dynmultipush("Gold Bottle Caps (¥2000)",ITEM_HP_GOLD_BOTTLE_CAP)
		addvar(VAR_TEMP_A, 1)
	}

	if(!flag(FLAG_POCKET_BIRCH_BAG_UNLOCKED)){
		dynmultipush("Pkt Birch Bag (¥1000)",ITEM_POCKET_BIRCH_BAG)
		addvar(VAR_TEMP_A, 1)
	}


	if(var(VAR_TEMP_A) != 0){
		showcoinsbox(21, 11)
		dynmultistack(0, 0, FALSE, 5, FALSE, 0, DYN_MULTICHOICE_CB_SHOW_ITEM)
		switch(var(VAR_RESULT)){
			case ITEM_LUM_BERRY:
				if(!flag(FLAG_LUM_BERRY_UNLOCKED)){
					checkcoins(VAR_RESULT)
						if(var(VAR_RESULT)>=500){
							setflag(FLAG_LUM_BERRY_UNLOCKED)
							removecoins(500)
							updatecoinsbox(0,0)
							playse(SE_SHOP)
							msgbox("You've unlocked Lum Berry as a\nstocked item!\pThank you for your purchase!")
						}
						else{
							msgbox("I'm sorry. You don't have the coins to\nstock that item, kec.")
						}
				}
			case ITEM_SERIOUS_MINT:
