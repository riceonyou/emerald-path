script Hub_Event_Script_Chansey{
    lockall
	faceplayer
    setvar(VAR_TEMP_A, 0)
	if(flag(FLAG_BULBASAUR_UNLOCKED) && var(VAR_STARTER_MON) != SPECIES_BULBASAUR){dynmultipush("Bulbasaur",SPECIES_BULBASAUR) addvar(VAR_TEMP_A,1)}
	if(flag(FLAG_CHARMANDER_UNLOCKED) && var(VAR_STARTER_MON) != SPECIES_CHARMANDER){dynmultipush("Charmander",SPECIES_CHARMANDER) addvar(VAR_TEMP_A,1)}
