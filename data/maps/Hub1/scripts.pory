script GiveStarterCharm {
	setvar(VAR_0x8000, 0)
    setvar(VAR_0x8001, 0)
    setvar(VAR_0x8002, 0)
    setvar(VAR_0x8003, 0)
    while (var(VAR_0x8000) != 3) {
        randomelement(ITEM_SHINY_STARTER_CHARM, ITEM_LUMP_SUM_CHARM, ITEM_BERRY_PACK_CHARM)
        if (var(VAR_RESULT) != VAR_0x8002 && var(VAR_RESULT) != VAR_0x8003 && var(VAR_0x8001) == 0){
            copyvar(VAR_0x8001, VAR_RESULT)
            addvar(VAR_0x8000, 1)
        }
        if (var(VAR_RESULT) != VAR_0x8001 && var(VAR_RESULT) != VAR_0x8003 && var(VAR_0x8002) == 0){
            copyvar(VAR_0x8002, VAR_RESULT)
            addvar(VAR_0x8000, 1)
        }
        if (var(VAR_RESULT) != VAR_0x8001 && var(VAR_RESULT) != VAR_0x8002 && var(VAR_0x8003) == 0){
            copyvar(VAR_0x8003, VAR_RESULT)
            addvar(VAR_0x8000, 1)
        }
    }
    if (var(VAR_0x8001) == ITEM_SHINY_STARTER_CHARM || var(VAR_0x8002) == ITEM_SHINY_STARTER_CHARM || var(VAR_0x8003) == ITEM_SHINY_STARTER_CHARM) {
        dynmultipush("Shiny Starter Charm", ITEM_SHINY_STARTER_CHARM)    
    }
    if (var(VAR_0x8001) == ITEM_LUMP_SUM_CHARM || var(VAR_0x8002) == ITEM_LUMP_SUM_CHARM || var(VAR_0x8003) == ITEM_LUMP_SUM_CHARM) {
        dynmultipush("Lump Sum Charm", ITEM_LUMP_SUM_CHARM)
    }
    if (var(VAR_0x8001) == ITEM_BERRY_PACK_CHARM || var(VAR_0x8002) == ITEM_BERRY_PACK_CHARM || var(VAR_0x8003) == ITEM_BERRY_PACK_CHARM) {
        dynmultipush("Berry Pack Charm", ITEM_BERRY_PACK_CHARM)
    }
    dynmultistack(0,0, TRUE, 3, FALSE, 0, DYN_MULTICHOICE_CB_SHOW_ITEM)
    switch (var(VAR_RESULT)) {
        case ITEM_SHINY_STARTER_CHARM:
			setflag(FLAG_NEXT_GIVE_MON_SHINY)
			special(ZeroPlayerPartyMons)
			special(GiveSavedStarter)
			special(UpdatePlayerSprite)
			special(UpdateTransformedPlayerPalette)
            giveitem(ITEM_SHINY_STARTER_CHARM, 1)
			playfanfare(MUS_LEVEL_UP)
        case ITEM_LUMP_SUM_CHARM:
            giveitem(ITEM_LUMP_SUM_CHARM, 1)
			addmoney(1500)
			playfanfare(MUS_OBTAIN_ITEM)
        case ITEM_BERRY_PACK_CHARM:
            giveitem(ITEM_BERRY_PACK_CHARM, 1)
			giveitem(ITEM_ORAN_BERRY, 1)
			giveitem(ITEM_SITRUS_BERRY, 1)
			giveitem(ITEM_BERRY_JUICE, 1)
			giveitem(ITEM_LUM_BERRY, 1)
    }
	msgbox("Good luck on your run!")
    waitmessage
}