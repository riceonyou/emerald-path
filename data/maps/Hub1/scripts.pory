				setvar(VAR_STARTER_MON, SPECIES_QUAXLY)
		}
		special(UpdatePlayerSprite)
		special(UpdateTransformedPlayerPalette)
		releaseall
		
		lockall
		msgbox("Use this item to level up your\nPokemon.")
		giveitem(ITEM_CANDY_JAR)

		releaseall
	}
}

script Hub_Event_Script_Birch{
    lockall
	faceplayer
    msgbox("Would you like to start a run?", MSGBOX_YESNO)
		switch (var(VAR_RESULT)) {
			case YES:
				msgbox("Alright then! Here we go!")
				call(GiveStarterCharm)
				special(WarpToNextAct)
			case NO:
				msgbox("Okay! Let me know when you're ready.")
				releaseall
		}
}

script Hub_Event_Script_Miltank{
    lockall
	faceplayer
	setvar(VAR_TEMP_A, 0)
    
	if(!flag(FLAG_BULBASAUR_UNLOCKED)){dynmultipush("Bulbasaur (¥500)",SPECIES_BULBASAUR) addvar(VAR_TEMP_A,1)}
	if(!flag(FLAG_CHARMANDER_UNLOCKED)){dynmultipush("Charmander (¥500)",SPECIES_CHARMANDER) addvar(VAR_TEMP_A,1)}
	if(!flag(FLAG_SQUIRTLE_UNLOCKED)){dynmultipush("Squirtle (¥500)",SPECIES_SQUIRTLE) addvar(VAR_TEMP_A,1)}
	if(!flag(FLAG_CHIKORITA_UNLOCKED)){dynmultipush("Chikorita (¥500)",SPECIES_CHIKORITA) addvar(VAR_TEMP_A,1)}
	if(!flag(FLAG_CYNDAQUIL_UNLOCKED)){dynmultipush("Cyndaquil (¥500)",SPECIES_CYNDAQUIL) addvar(VAR_TEMP_A,1)}
	if(!flag(FLAG_TOTODILE_UNLOCKED)){dynmultipush("Totodile (¥500)",SPECIES_TOTODILE) addvar(VAR_TEMP_A,1)}
	if(!flag(FLAG_TREECKO_UNLOCKED)){dynmultipush("Treecko (¥500)",SPECIES_TREECKO) addvar(VAR_TEMP_A,1)}
	if(!flag(FLAG_TORCHIC_UNLOCKED)){dynmultipush("Torchic (¥500)",SPECIES_TORCHIC) addvar(VAR_TEMP_A,1)}
	if(!flag(FLAG_MUDKIP_UNLOCKED)){dynmultipush("Mudkip (¥500)",SPECIES_MUDKIP) addvar(VAR_TEMP_A,1)}
	if(!flag(FLAG_TURTWIG_UNLOCKED)){dynmultipush("Turtwig (¥500)",SPECIES_TURTWIG) addvar(VAR_TEMP_A,1)}
	if(!flag(FLAG_CHIMCHAR_UNLOCKED)){dynmultipush("Chimchar (¥500)",SPECIES_CHIMCHAR) addvar(VAR_TEMP_A,1)}
