script HUB1_Run_Stats_Sign {
    lockall

    buffernumberstring(STR_VAR_1, VAR_TOTAL_RUNS)
    buffernumberstring(STR_VAR_2, VAR_ACT1_WINS)
    buffernumberstring(STR_VAR_3, VAR_ACT2_WINS)
    msgbox("Total Runs: {STR_VAR_1}\nAct 1 Wins: {STR_VAR_2}")
    waitmessage

    buffernumberstring(STR_VAR_1, VAR_ACT3_WINS)
    buffernumberstring(STR_VAR_2, VAR_ACT4_WINS)
	buffernumberstring(STR_VAR_3, VAR_ACT2_WINS)
    msgbox("Act 2 Wins: {STR_VAR_3}\nAct 3 Wins: {STR_VAR_1}\pAct 4 Wins: {STR_VAR_2}")
    waitmessage

    releaseall
}

script HUB1_ONWARP {
    setvar(VAR_TEMP_1, 1)
}

script HUB1_ONFRAME {
	setvar(VAR_TEMP_2, 1)
	call(AfterWarpIntoNewAct)


	if(!flag(FLAG_SYS_NEW_GAME)){// STUFF FOR NEW GAME
		lockall

		//Set Starter Vars and Flags
		setflag(FLAG_SYS_NEW_GAME)
		setvar(VAR_SHINY_RATE, 4096)//4096 originally
		setvar(VAR_LEVEL_CAP, 14)

