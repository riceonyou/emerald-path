script AbraTeleport{
	lockall
	if(!flag(FLAG_DEFEATED_PATH_LEADER)){
		msgbox("You'll have to defeat the leader first\nbefore I can teleport you\lto the next act.")
		releaseall
	}
	else{
		msgbox("Would you like to teleport\nto the next act?", MSGBOX_YESNO)
		switch (var(VAR_RESULT)) {
			case YES:
				msgbox("Alright then! Here we go!")
				clearflag(FLAG_DEFEATED_PATH_LEADER)
				special(WarpToNextAncient)
			case NO:
				msgbox("Okay! Let me know when you're ready.")
				releaseall
		}
	}
}

script RivalFight1 {
	switch (var(VAR_CURRENT_RIVAL)){
        case 0:
            trainerbattle_single(TRAINER_TREECKO, "Yo I'm Treecko. You seem like\nA worthy rival! Grrr!", "Damn you got me.")
            msgbox("I'll get you next time. Just you\nwait and see!", MSGBOX_AUTOCLOSE) 
            waitmessage
            end
        case 1:
            trainerbattle_single(TRAINER_TORCHIC, "Yo I'm Torchic. You seem like\nA worthy rival! Grrr!", "Damn you got me.")
            msgbox("I'll get you next time. Just you\nwait and see!", MSGBOX_AUTOCLOSE) 
            waitmessage
            end
    }
}

script RivalFight2 {
    switch (var(VAR_CURRENT_RIVAL)){
        case 0:
            trainerbattle_single(TRAINER_GROVYLE, "Sup. Let's do this.", "Grrrr...")
            msgbox("Just you wait. I'll come back even\nstronger.", MSGBOX_AUTOCLOSE) 
            waitmessage
            end
        case 1:
            trainerbattle_single(TRAINER_COMBUSKEN, "I'm fired up and ready to fight!", "Noooo!")
            msgbox("I need to train even more...", MSGBOX_AUTOCLOSE) 
            waitmessage
            end
    }
}

script RivalFight3 {
    switch (var(VAR_CURRENT_RIVAL)){
        case 0:
            trainerbattle_single(TRAINER_SCEPTILE, "You ready?", "I still can't beat you...")
            msgbox("Let's fight again.", MSGBOX_AUTOCLOSE) 
            waitmessage
            end
        case 1:
            trainerbattle_single(TRAINER_BLAZIKEN, "Raaaa!\nLet's give it our all!", "I'm still not strong enough...")
            msgbox("I'm still not strong enough...", MSGBOX_AUTOCLOSE) 
            waitmessage
            end
    }
}

script RivalFight4 {
    switch (var(VAR_CURRENT_RIVAL)){
        case 0:
            trainerbattle_single(TRAINER_MEGASCEPTILE, "One last time...", "......")
            msgbox("Good luck.", MSGBOX_AUTOCLOSE) 
            waitmessage
            end
        case 1:
            trainerbattle_single(TRAINER_MBLAZIKEN, "I can't wait to show you how much\nstronger I've gotten!", "I'm in shock...\pYou really are the strongest.")
            msgbox("I hope you crush it with the last\nremaining fights!", MSGBOX_AUTOCLOSE) 
            waitmessage
            end
    }
}


