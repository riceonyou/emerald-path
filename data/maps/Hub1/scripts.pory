script Hub_Event_Script_Marowak {
	faceplayer
	msgbox(format("Hi. My dojo is closed right now. Maybe it will open in a future update."))
	closemessage
	applymovement(1, moves(
        face_down
    ))
}




script Hub_Event_Script_Chimecho {

	msgbox("Heya. Would you like to\nsee your unlocked starter charms?", type=MSGBOX_YESNO)
	if(var(VAR_RESULT)){
		closemessage
	backtocharmslist:
		dynmultipush("Shiny Starter Charm", ITEM_SHINY_STARTER_CHARM) 
		dynmultipush("Lump Sum", ITEM_LUMP_SUM_CHARM)   
		dynmultipush("Berry Pack", ITEM_BERRY_PACK_CHARM) 
		if(flag(FLAG_TINTED_CHARM_STARTER_UNLOCKED)){dynmultipush("Tinted Scope", ITEM_TINTED_CHARM) }
		if(flag(FLAG_NORMAL_CHARM_STARTER_UNLOCKED)){dynmultipush("Normal Charm", ITEM_NORMAL_CHARM) }
		if(flag(FLAG_MINTY_CHARM_STARTER_UNLOCKED)){dynmultipush("Mint Pot", ITEM_MINTY_CHARM) }
		if(flag(FLAG_BRUXISH_FLOSS_CHARM_UNLOCKED)){dynmultipush("Bruxish Floss", ITEM_BRUXISH_FLOSS_CHARM) }
		if(flag(FLAG_UNOWN_BUDDY_CHARM_UNLOCKED)){dynmultipush("Unown Buddy", ITEM_UNOWN_BUDDY_CHARM) }

		dynmultistack(0, 0, FALSE, 8, FALSE, 0, DYN_MULTICHOICE_CB_SHOW_ITEM)
		switch (var(VAR_RESULT)){
			case MULTI_B_PRESSED:
				msgbox(format("Keep playing more to unlock more starter charms!"))
				releaseall
				end
			case ITEM_SHINY_STARTER_CHARM:
				msgbox(format("Your starter pokemon becomes shiny."))
			case ITEM_LUMP_SUM_CHARM:
				msgbox(format("Gain ¥1500."))
			case ITEM_BERRY_PACK_CHARM:
				msgbox(format("Gain an oran berry, a sitrus berry, a lum berry and a berry juice."))
			case ITEM_TINTED_CHARM:
				msgbox(format("Your not very effective moves do 1.5 times more damage."))
			case ITEM_NORMAL_CHARM:
				msgbox(format("Your normal moves do 1.1 times more damage."))
			case ITEM_MINTY_CHARM:
				msgbox(format("Gain a random mint at the start of each path."))
			case ITEM_BRUXISH_FLOSS_CHARM:
				msgbox(format("Your biting moves do 1.2 dmg."))
			case ITEM_UNOWN_BUDDY_CHARM:
				msgbox(format("Get an extra unown at the start of the run."))
		}
		closemessage
		goto(backtocharmslist)	
	}
	else{
		msgbox(format("Ok then! Keep playing more to unlock more starter charms!"))
		releaseall
	}
	
}

script GiveStarterCharm {
	special(BufferStarterCharms)
	if (var(VAR_0x8001) == ITEM_SHINY_STARTER_CHARM || var(VAR_0x8002) == ITEM_SHINY_STARTER_CHARM || var(VAR_0x8003) == ITEM_SHINY_STARTER_CHARM) {
        dynmultipush("Shiny Starter Charm", ITEM_SHINY_STARTER_CHARM)    
    }
	if (var(VAR_0x8001) == ITEM_LUMP_SUM_CHARM || var(VAR_0x8002) == ITEM_LUMP_SUM_CHARM || var(VAR_0x8003) == ITEM_LUMP_SUM_CHARM) {
        dynmultipush("Lump Sum", ITEM_LUMP_SUM_CHARM)    
    }
	if (var(VAR_0x8001) == ITEM_BERRY_PACK_CHARM || var(VAR_0x8002) == ITEM_BERRY_PACK_CHARM || var(VAR_0x8003) == ITEM_BERRY_PACK_CHARM) {
        dynmultipush("Berry Pack", ITEM_BERRY_PACK_CHARM)    
    }
	if (var(VAR_0x8001) == ITEM_TINTED_CHARM || var(VAR_0x8002) == ITEM_TINTED_CHARM || var(VAR_0x8003) == ITEM_TINTED_CHARM) {
        dynmultipush("Tinted Scope", ITEM_TINTED_CHARM)    
    }
	if (var(VAR_0x8001) == ITEM_NORMAL_CHARM || var(VAR_0x8002) == ITEM_NORMAL_CHARM || var(VAR_0x8003) == ITEM_NORMAL_CHARM) {
        dynmultipush("Normal Charm", ITEM_NORMAL_CHARM)    
    }
	if (var(VAR_0x8001) == ITEM_MINTY_CHARM || var(VAR_0x8002) == ITEM_MINTY_CHARM || var(VAR_0x8003) == ITEM_MINTY_CHARM) {
        dynmultipush("Mint Pot", ITEM_MINTY_CHARM)    
    }
	if (var(VAR_0x8001) == ITEM_BRUXISH_FLOSS_CHARM || var(VAR_0x8002) == ITEM_BRUXISH_FLOSS_CHARM || var(VAR_0x8003) == ITEM_BRUXISH_FLOSS_CHARM) {
        dynmultipush("Bruxish Floss", ITEM_BRUXISH_FLOSS_CHARM)    
    }
	if (var(VAR_0x8001) == ITEM_UNOWN_BUDDY_CHARM || var(VAR_0x8002) == ITEM_UNOWN_BUDDY_CHARM || var(VAR_0x8003) == ITEM_UNOWN_BUDDY_CHARM) {
        dynmultipush("Unown Buddy", ITEM_UNOWN_BUDDY_CHARM)    
    }
    dynmultistack(0,0, TRUE, 3, FALSE, 0, DYN_MULTICHOICE_CB_SHOW_ITEM)
    switch (var(VAR_RESULT)) {
        case ITEM_SHINY_STARTER_CHARM:
			setflag(FLAG_NEXT_GIVE_MON_SHINY)
			special(ZeroPlayerPartyMons)
			special(GiveSavedStarter)
			special(UpdatePlayerSprite)
			special(UpdateTransformedPlayerPalette)
            giveitem(ITEM_SHINY_STARTER_CHARM, 1)
			playfanfare(MUS_LEVEL_UP)
        case ITEM_LUMP_SUM_CHARM:
            giveitem(ITEM_LUMP_SUM_CHARM, 1)
			addmoney(1500)
			playfanfare(MUS_OBTAIN_ITEM)
        case ITEM_BERRY_PACK_CHARM:
            giveitem(ITEM_BERRY_PACK_CHARM, 1)
			giveitem(ITEM_ORAN_BERRY, 1)
			giveitem(ITEM_SITRUS_BERRY, 1)
			giveitem(ITEM_BERRY_JUICE, 1)
			giveitem(ITEM_LUM_BERRY, 1)
		case ITEM_TINTED_CHARM:
            giveitem(ITEM_TINTED_CHARM, 1)
		case ITEM_NORMAL_CHARM:
            giveitem(ITEM_NORMAL_CHARM, 1)
		case ITEM_MINTY_CHARM:
            giveitem(ITEM_MINTY_CHARM, 1)
		case ITEM_BRUXISH_FLOSS_CHARM:
            giveitem(ITEM_BRUXISH_FLOSS_CHARM, 1)
		case ITEM_UNOWN_BUDDY_CHARM:
            giveitem(ITEM_UNOWN_BUDDY_CHARM, 1)
			givemon(SPECIES_UNOWN, 14)

    }
	msgbox("Good luck on your run!")
    waitmessage
}


//==================================DIALOGUE ONLY NPCS=======================================
script Hub_Event_Script_Golem {
	lockall
	faceplayer
	if(!flag(FLAG_MEGA_SHOP_UNLOCKED)){
		msgbox(format("Diancie over there has a large mega stone collection.\pI wonder if she'll start selling them one day... I've heard that getting to the 4th path might do it...\pNot that I would be able to make use of one anyway... I wish I had a mega evolution..."))
	}else{
		msgbox(format("So Diancie's finally started to sell mega stones! Apparently if you get to the 4th path with a pokemon that can mega evolve, she'll start selling that pokemon's mega stone."))
	}
	waitmessage
	releaseall
}

script Hub_Event_Script_Togedemaru {
	lockall
	faceplayer
	random(2)
	switch(var(VAR_RESULT)){
		case 0:
			msgbox(format("Hey. I'm Togedemaru. I'm spiky and round!"))
		case 1:
			msgbox(format("Hey. In this game, pokemon can have up to 4 abilities! Like me! I have Iron Barbs, Static, Sturdy and Cute Charm! But not all pokemon have as many abilites as me hehe."))
	}
		
	waitmessage
	releaseall
}

script Hub_Event_Script_Klang {
	lockall
	faceplayer
	msgbox(format("Hello. You should know that the items your pokemon are holding before a battle are restored at the end of a battle.\pThis means that the berries your pokemon consume will be returned.\pIt also means any item you might steal during a battle are not kept."))
	waitmessage
	releaseall
}

script Hub_Event_Script_Bruxish {
	lockall
	faceplayer
	if(!flag(FLAG_BRUXISH_FLOSS_CHARM_UNLOCKED)){
		msgbox(format("You want to know how I have such beatiful teeth? Well you've got to take good care of them of course! Make sure to brush twice a day, and floss every night!"))
		setflag(FLAG_BRUXISH_FLOSS_CHARM_UNLOCKED)
		playfanfare(MUS_EVOLVED)
		msgbox("You unlocked Bruxish Floss as\na starter charm!")
		waitmessage
	}else{
		msgbox("Don't forget to floss everyday!")
		waitmessage
	}
	releaseall
}

script Hub_Event_Script_Simisage {
	lockall
	faceplayer
	msgbox(format("Hi. Did you know that in this game, a pokemon can learn any TM. That means even a grass-type like me can learn a fire-type move by TM!\pBut of course I won't get a same type attack bonus from it."))
	waitmessage
	releaseall	
}

script Hub_Event_Script_Woobat {
	lockall
	faceplayer
	msgbox(format("Did you know that some abilities got changed in this game? Like my ability Klutz. It still doesn't let me use items, but it also gives me a 10% chance to dodge moves!"))
	waitmessage
	releaseall
}


script Hub_Event_Script_Unown {
	lockall
	faceplayer
	if(!flag(FLAG_UNOWN_BUDDY_CHARM_UNLOCKED)){
		msgbox(format("Hi. I know I'm a pretty weak pokemon, but If you choose me, you'll get an extra unown for free, thanks to my Herd ability!"))
		setflag(FLAG_UNOWN_BUDDY_CHARM_UNLOCKED)
		msgbox("You unlocked Unown Buddy as\na starter charm!")
		playfanfare(MUS_EVOLVED)
		waitmessage
	}else{
		msgbox("If you choose me, you'll get an\nextra unown as well!")
		waitmessage
	}
	releaseall
}

script Hub_Event_Script_Smoliv {
	lockall
	faceplayer
	msgbox(format("Hey.\pYou should know that the money you get during a run (¥) is different to the money you spend when you're here at the hub (Coins)."))
	waitmessage
	releaseall
}