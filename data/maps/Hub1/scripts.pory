script Hub_Event_Script_Chimecho {

	if(var(VAR_TOTAL_RUNS) < 3){
		msgbox("Heya. I sell starter charms.
				But I'm not open just yet.
				Try playing some more runs first, chim!")
	}
	else{}
	lockall
	faceplayer
	setvar(VAR_TEMP_A, 0)
	msgbox("Ding! Would you like to\nbuy a starter TM?")
	if(!flag(FLAG_TM_ROCK_SMASH_UNLOCKED)){
		dynmultipush("TM Rock Smash (¥8000)",ITEM_TM_ROCK_SMASH)
		addvar(VAR_TEMP_A, 1)
	}

	if(var(VAR_TEMP_A) != 0){
		showmoneybox(17, 10)
		dynmultistack(0, 0, FALSE, 4, FALSE, 0, DYN_MULTICHOICE_CB_SHOW_ITEM)
		switch(var(VAR_RESULT)){
			case ITEM_TM_NOBLE_ROAR:
				if(!flag(FLAG_TM_NOBLE_ROAR_UNLOCKED)){
					if(checkmoney(4000)){
							setflag(FLAG_TM_NOBLE_ROAR_UNLOCKED)
							giveitem(ITEM_TM_NOBLE_ROAR, 1)
							removemoney(4000)
							updatemoneybox
							playse(SE_SHOP)
							msgbox("You got TM Noble Roar as a starter\nitem!\pThank you for your purchase!")
						}
						else{
							msgbox("I'm sorry. You don't have the money to\nbuy that item, kec.")
						}
				}
			case ITEM_TM_ROCK_SMASH:
				if(!flag(FLAG_TM_ROCK_SMASH_UNLOCKED)){
					if(checkmoney(8000)){
							setflag(FLAG_TM_ROCK_SMASH_UNLOCKED)
							giveitem(ITEM_TM_ROCK_SMASH, 1)
							removemoney(8000)
							updatemoneybox
							playse(SE_SHOP)
							msgbox("You got TM Rock Smash as a starter\nitem!\pThank you for your purchase!")
						}
						else{
							msgbox("I'm sorry. You don't have the money to\nbuy that item, kec.")
						}
				}
			case ITEM_TM_SWIFT:
				if(!flag(FLAG_TM_SWIFT_UNLOCKED)){
					if(checkmoney(8000)){
							setflag(FLAG_TM_SWIFT_UNLOCKED)
							giveitem(ITEM_TM_SWIFT, 1)
							removemoney(8000)
							updatemoneybox
							playse(SE_SHOP)
							msgbox("You got TM Swift as a starter\nitem!\pThank you for your purchase!")
						}
						else{
							msgbox("I'm sorry. You don't have the money to\nbuy that item, kec.")
						}
				}
			case ITEM_TM_CUT:
				if(!flag(FLAG_TM_CUT_UNLOCKED)){
					if(checkmoney(8000)){
							setflag(FLAG_TM_CUT_UNLOCKED)
							giveitem(ITEM_TM_CUT, 1)
							removemoney(8000)
