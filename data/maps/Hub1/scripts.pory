	if(!flag(FLAG_SNIVY_UNLOCKED)){dynmultipush("Snivy (¥500)",SPECIES_SNIVY) addvar(VAR_TEMP_A,1)}
	if(!flag(FLAG_TEPIG_UNLOCKED)){dynmultipush("Tepig (¥500)",SPECIES_TEPIG) addvar(VAR_TEMP_A,1)}
	if(!flag(FLAG_OSHAWOTT_UNLOCKED)){dynmultipush("Oshawott (¥500)",SPECIES_OSHAWOTT) addvar(VAR_TEMP_A,1)}
	if(!flag(FLAG_CHESPIN_UNLOCKED)){dynmultipush("Chespin (¥500)",SPECIES_CHESPIN) addvar(VAR_TEMP_A,1)}
	if(!flag(FLAG_FENNEKIN_UNLOCKED)){dynmultipush("Fennekin (¥500)",SPECIES_FENNEKIN) addvar(VAR_TEMP_A,1)}
	if(!flag(FLAG_FROAKIE_UNLOCKED)){dynmultipush("Froakie (¥500)",SPECIES_FROAKIE) addvar(VAR_TEMP_A,1)}
	if(!flag(FLAG_ROWLET_UNLOCKED)){dynmultipush("Rowlet (¥500)",SPECIES_ROWLET) addvar(VAR_TEMP_A,1)}
	if(!flag(FLAG_LITTEN_UNLOCKED)){dynmultipush("Litten (¥500)",SPECIES_LITTEN) addvar(VAR_TEMP_A,1)}
	if(!flag(FLAG_POPPLIO_UNLOCKED)){dynmultipush("Popplio (¥500)",SPECIES_POPPLIO) addvar(VAR_TEMP_A,1)}
	if(!flag(FLAG_GROOKEY_UNLOCKED)){dynmultipush("Grookey (¥500)",SPECIES_GROOKEY) addvar(VAR_TEMP_A,1)}
	if(!flag(FLAG_SCORBUNNY_UNLOCKED)){dynmultipush("Scorbunny (¥500)",SPECIES_SCORBUNNY) addvar(VAR_TEMP_A,1)}
	if(!flag(FLAG_SOBBLE_UNLOCKED)){dynmultipush("Sobble (¥500)",SPECIES_SOBBLE) addvar(VAR_TEMP_A,1)}
	if(!flag(FLAG_SPRIGATITO_UNLOCKED)){dynmultipush("Sprigatito (¥500)",SPECIES_SPRIGATITO) addvar(VAR_TEMP_A,1)}
	if(!flag(FLAG_FUECOCO_UNLOCKED)){dynmultipush("Fuecoco (¥500)",SPECIES_FUECOCO) addvar(VAR_TEMP_A,1)}
	if(!flag(FLAG_QUAXLY_UNLOCKED)){dynmultipush("Quaxly (¥500)",SPECIES_QUAXLY) addvar(VAR_TEMP_A,1)}
	
	if (var(VAR_TEMP_A) != 0){
		showcoinsbox(21, 11)
		msgbox("Would you like to adopt a pokemon?")
		dynmultistack(0, 0, FALSE, 6, FALSE, 0, DYN_MULTICHOICE_CB_SHOW_MON)
				switch (var(VAR_RESULT)) {
					case MULTI_B_PRESSED:
						releaseall
					case SPECIES_BULBASAUR:
						checkcoins(VAR_RESULT)
						if(var(VAR_RESULT)>=500){
							setflag(FLAG_BULBASAUR_UNLOCKED)
							removecoins(500)
							updatecoinsbox(0,0)
							playse(SE_SHOP)
							msgbox("You unlocked Bulbasaur as a starter!\pThank you for your adoption!")
						}
						else{
							msgbox("I'm sorry. You don't have the coins to\nadopt that pokemon.")
						}
					case SPECIES_CHARMANDER:
						checkcoins(VAR_RESULT)
						if(var(VAR_RESULT)>=500){
							setflag(FLAG_CHARMANDER_UNLOCKED)
							removecoins(500)
							updatecoinsbox(0,0)
							playse(SE_SHOP)
