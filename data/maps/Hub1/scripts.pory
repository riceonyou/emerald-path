script Hub_Event_Script_Chansey{
    lockall
	faceplayer
    setvar(VAR_TEMP_A, 0)
	if(flag(FLAG_BULBASAUR_UNLOCKED) && var(VAR_STARTER_MON) != SPECIES_BULBASAUR){dynmultipush("Bulbasaur",SPECIES_BULBASAUR) addvar(VAR_TEMP_A,1)}
	if(flag(FLAG_CHARMANDER_UNLOCKED) && var(VAR_STARTER_MON) != SPECIES_CHARMANDER){dynmultipush("Charmander",SPECIES_CHARMANDER) addvar(VAR_TEMP_A,1)}
	if(flag(FLAG_SQUIRTLE_UNLOCKED) && var(VAR_STARTER_MON) != SPECIES_SQUIRTLE){dynmultipush("Squirtle",SPECIES_SQUIRTLE) addvar(VAR_TEMP_A,1)}
	if(flag(FLAG_CHIKORITA_UNLOCKED) && var(VAR_STARTER_MON) != SPECIES_CHIKORITA){dynmultipush("Chikorita",SPECIES_CHIKORITA) addvar(VAR_TEMP_A,1)}
	if(flag(FLAG_CYNDAQUIL_UNLOCKED) && var(VAR_STARTER_MON) != SPECIES_CYNDAQUIL){dynmultipush("Cyndaquil",SPECIES_CYNDAQUIL) addvar(VAR_TEMP_A,1)}
	if(flag(FLAG_TOTODILE_UNLOCKED) && var(VAR_STARTER_MON) != SPECIES_TOTODILE){dynmultipush("Totodile",SPECIES_TOTODILE) addvar(VAR_TEMP_A,1)}
	if(flag(FLAG_TREECKO_UNLOCKED) && var(VAR_STARTER_MON) != SPECIES_TREECKO){dynmultipush("Treecko",SPECIES_TREECKO) addvar(VAR_TEMP_A,1)}
	if(flag(FLAG_TORCHIC_UNLOCKED) && var(VAR_STARTER_MON) != SPECIES_TORCHIC){dynmultipush("Torchic",SPECIES_TORCHIC) addvar(VAR_TEMP_A,1)}
	if(flag(FLAG_MUDKIP_UNLOCKED) && var(VAR_STARTER_MON) != SPECIES_MUDKIP){dynmultipush("Mudkip",SPECIES_MUDKIP) addvar(VAR_TEMP_A,1)}
	if(flag(FLAG_TURTWIG_UNLOCKED) && var(VAR_STARTER_MON) != SPECIES_TURTWIG){dynmultipush("Turtwig",SPECIES_TURTWIG) addvar(VAR_TEMP_A,1)}
	if(flag(FLAG_CHIMCHAR_UNLOCKED) && var(VAR_STARTER_MON) != SPECIES_CHIMCHAR){dynmultipush("Chimchar",SPECIES_CHIMCHAR) addvar(VAR_TEMP_A,1)}
	if(flag(FLAG_PIPLUP_UNLOCKED) && var(VAR_STARTER_MON) != SPECIES_PIPLUP){dynmultipush("Piplup",SPECIES_PIPLUP) addvar(VAR_TEMP_A,1)}
	if(flag(FLAG_SNIVY_UNLOCKED) && var(VAR_STARTER_MON) != SPECIES_SNIVY){dynmultipush("Snivy",SPECIES_SNIVY) addvar(VAR_TEMP_A,1)}
	if(flag(FLAG_TEPIG_UNLOCKED) && var(VAR_STARTER_MON) != SPECIES_TEPIG){dynmultipush("Tepig",SPECIES_TEPIG) addvar(VAR_TEMP_A,1)}
	if(flag(FLAG_OSHAWOTT_UNLOCKED) && var(VAR_STARTER_MON) != SPECIES_OSHAWOTT){dynmultipush("Oshawott",SPECIES_OSHAWOTT) addvar(VAR_TEMP_A,1)}
	if(flag(FLAG_CHESPIN_UNLOCKED) && var(VAR_STARTER_MON) != SPECIES_CHESPIN){dynmultipush("Chespin",SPECIES_CHESPIN) addvar(VAR_TEMP_A,1)}
	if(flag(FLAG_FENNEKIN_UNLOCKED) && var(VAR_STARTER_MON) != SPECIES_FENNEKIN){dynmultipush("Fennekin",SPECIES_FENNEKIN) addvar(VAR_TEMP_A,1)}
	if(flag(FLAG_FROAKIE_UNLOCKED) && var(VAR_STARTER_MON) != SPECIES_FROAKIE){dynmultipush("Froakie",SPECIES_FROAKIE) addvar(VAR_TEMP_A,1)}
	if(flag(FLAG_ROWLET_UNLOCKED) && var(VAR_STARTER_MON) != SPECIES_ROWLET){dynmultipush("Rowlet",SPECIES_ROWLET) addvar(VAR_TEMP_A,1)}
	if(flag(FLAG_LITTEN_UNLOCKED) && var(VAR_STARTER_MON) != SPECIES_LITTEN){dynmultipush("Litten",SPECIES_LITTEN) addvar(VAR_TEMP_A,1)}
	if(flag(FLAG_POPPLIO_UNLOCKED) && var(VAR_STARTER_MON) != SPECIES_POPPLIO){dynmultipush("Popplio",SPECIES_POPPLIO) addvar(VAR_TEMP_A,1)}
	if(flag(FLAG_GROOKEY_UNLOCKED) && var(VAR_STARTER_MON) != SPECIES_GROOKEY){dynmultipush("Grookey",SPECIES_GROOKEY) addvar(VAR_TEMP_A,1)}
	if(flag(FLAG_SCORBUNNY_UNLOCKED) && var(VAR_STARTER_MON) != SPECIES_SCORBUNNY){dynmultipush("Scorbunny",SPECIES_SCORBUNNY) addvar(VAR_TEMP_A,1)}
	if(flag(FLAG_SOBBLE_UNLOCKED) && var(VAR_STARTER_MON) != SPECIES_SOBBLE){dynmultipush("Sobble",SPECIES_SOBBLE) addvar(VAR_TEMP_A,1)}
	if(flag(FLAG_SPRIGATITO_UNLOCKED) && var(VAR_STARTER_MON) != SPECIES_SPRIGATITO){dynmultipush("Sprigatito",SPECIES_SPRIGATITO) addvar(VAR_TEMP_A,1)}
	if(flag(FLAG_FUECOCO_UNLOCKED) && var(VAR_STARTER_MON) != SPECIES_FUECOCO){dynmultipush("Fuecoco",SPECIES_FUECOCO) addvar(VAR_TEMP_A,1)}
	if(flag(FLAG_QUAXLY_UNLOCKED) && var(VAR_STARTER_MON) != SPECIES_QUAXLY){dynmultipush("Quaxly",SPECIES_QUAXLY) addvar(VAR_TEMP_A,1)}
	
	if(var(VAR_TEMP_A) != 0){
		setvar(VAR_RESULT, 0)
		msgbox("Would you like to change your starter?")
		dynmultistack(0, 0, FALSE, 6, FALSE, 0, DYN_MULTICHOICE_CB_SHOW_MON)

		if(!(var(VAR_RESULT) == MULTI_B_PRESSED)){
			copyvar(VAR_STARTER_MON, VAR_RESULT)
			special(ZeroPlayerPartyMons)
			special(GiveSavedStarter)
			special(UpdatePlayerSprite)
			special(UpdateTransformedPlayerPalette)
			playfanfare(MUS_LEVEL_UP)
			releaseall
			lockall
			playse(SE_SUCCESS)
			msgbox("There you go!")
			waitmessage
			releaseall
		}
		else{
			releaseall
		}
	}else{
		msgbox("You don't have any starter pokemon yet.\pPlease consider adopting some pokemon\nfrom my friend Miltank to the right.")
		waitmessage
		releaseall}
}

script KecShop_Sign {
    lockall
    msgbox("Welcome to the Kecleon Brother's shop!")
    waitmessage
    releaseall
}

script KecShop {
    lockall
    msgbox("Welcome to the Kecleon Brother's shop!")
	dynmultipush("Oran Berry (¥200)",ITEM_ORAN_BERRY)
	dynmultipush("Mem. Mushroom (¥200)",ITEM_MEMORY_MUSHROOM)
	addvar(VAR_TEMP_A, 1)
	if(flag(FLAG_LUM_BERRY_BUYABLE)){
		dynmultipush("Lum Berry (¥200)",ITEM_LUM_BERRY)
		addvar(VAR_TEMP_A, 1)
