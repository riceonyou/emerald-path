script Elite4_Hoenn_2_EventScript_MegaSwampert{

	trainerbattle_single(TRAINER_MEGASWAMPERT, "I am the champion.\pYou have done well to get this far.\pNow let us have a wonderful\nfinal battle.", "You are the champion.", Elite4_Hoenn_2_CHAMPION_DEFEATED)
	msgbox("test.", MSGBOX_AUTOCLOSE) 
	waitmessage
    end

}

script Elite4_Hoenn_2_CHAMPION_DEFEATED{
	playbgm(MUS_VICTORY_LEAGUE, 0)
	msgbox("Congratulations.\pYou have conquered all 4 paths.\pYou are truly great.\pGood job.\pEtcetra etcetra...\pNow go back to the Hub.", MSGBOX_AUTOCLOSE) 
	waitmessage
	
	applymovement(LOCALID_PLAYER, moves(
        face_down
        jump_in_place_down * 2
		delay_8
		face_left
		face_up
		face_right
		face_down
		delay_16
		jump_in_place_down
		walk_down
		walk_up
		walk_left
		walk_right * 2
		walk_left
		face_down
    ))
	waitmovement
    applymovement(LOCALID_PLAYER, moves(
		jump_in_place_down * 10
    ))
	msgbox("Yipee!")
	waitmessage
	special(WarpToNextAct)
	end

}

