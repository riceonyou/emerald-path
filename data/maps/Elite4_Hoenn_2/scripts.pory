mapscripts Elite4_Hoenn_2_MapScripts {
}

script Elite4_Hoenn_2_EventScript_MegaAbsol{
	if(!defeated(TRAINER_MEGAABSOL)){
		lockall
		applymovement(megaabsol, moves(
			face_player
			emote_exclamation_mark
			delay_16
			delay_16
		))			
		waitmovement
		applymovement(megaabsol, moves(
			walk_right * 1
		))
		waitmovement
		msgbox(format("Welcome to the Elite 4.\pFrom here, you will fight 4 extremely strong trainers, and the champion.\pPlease note that there is a special rule with battling the Elite 4.\pThat is, you must battle 2 of us as a SINGLES battle, and 2 of us as a DOUBLES battle.\pYou may choose which one of us to battle in which format.\pNow, how would you like to battle me?"))
		if(var(VAR_ELITE4_SINGLES_BATTLE_COUNT) < 2){
			dynmultipush("SINGLES", 0)
			
		}
		if(var(VAR_ELITE4_DOUBLES_BATTLE_COUNT) < 2){
			dynmultipush("DOUBLES", 1)
		}
		dynmultistack(0,0,TRUE,2,FALSE,0,DYN_MULTICHOICE_CB_NONE)
		copyvar(VAR_0x8000, VAR_RESULT)
		if(var(VAR_0x8000) == 0){
			addvar(VAR_ELITE4_SINGLES_BATTLE_COUNT, 1)
			msgbox("A singles battle it is.\nI hope you are prepared.")
			trainerbattle_no_intro(TRAINER_MEGAABSOL, "An exhilirating battle.")
		}
		if(var(VAR_0x8000) == 1){
			addvar(VAR_ELITE4_DOUBLES_BATTLE_COUNT, 1)
			msgbox("A doubles battle it is.\nI hope you are prepared.")
			setflag(FLAG_FORCE_DOUBLES_BATTLE)
			trainerbattle_no_intro(TRAINER_MEGAABSOL, "An exhilirating battle.")
		}
		msgbox("I wish you good luck.", MSGBOX_AUTOCLOSE)
		waitmessage
		releaseall
	}
	
}
script MegaAbsol{
	msgbox("I wish you good luck.", MSGBOX_AUTOCLOSE)
	waitmessage
    releaseall
}

