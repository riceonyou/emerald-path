script Hoenn2_4_Itemball_1{
    lockall
    call(GiveCommonItem)
    removeobject(Hoenn2_Ball1)
    setflag(FLAG_ITEM_2_1)
    releaseall
    end
}

script Hoenn2_4_Itemball_2{
    lockall
    call(GiveUncommonItem)
    removeobject(Hoenn2_Ball2)
    setflag(FLAG_ITEM_2_2)
    releaseall
    end
}