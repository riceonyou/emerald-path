mapscripts ANCIENT1_MapScripts {
}


script ANCIENT_1_EventScript_Regigigas{
    lockall
    //faceplayer
    //GIVE ANCIENT REWARD
    playmoncry(SPECIES_REGIGIGAS, CRY_MODE_ENCOUNTER)
    waitmoncry
    applymovement(1, moves(
        face_left
        face_up
        face_right
        face_down
        face_player
    ))
    waitmovement
    msgbox(format("Brrrr!\pHiya! You've just beaten 3 paths! Amazing!\nHere's a gift for you."))
    waitmessage
    giveitem(ITEM_ARCHIES_BANDANA_CHARM, 1)
    msgbox(format("It's a keepsake from my late friend. We once shared a dream for the world, but a lots changed since then.\pAnyways, enough reminiscing. While you have that item, all of your moves do 1.5 damage in the rain. Not just your water type moves. And a pokemon with the Drizzle ability would go along well with that item, won't it?"))
    waitmessage
    fadescreen(FADE_TO_BLACK)
    setvar(VAR_0x8000, 39)
    special(LoadBirchBagPoolById)
    special(ChooseBirchBagPokemonWeighted)
    waitstate
    playfanfare(MUS_EVOLVED)
	msgbox("You received a\n{STR_VAR_1}!")
    msgbox(format("And please take a Rain Dance TM too."))
    waitmessage
    giveitem(ITEM_TM_RAIN_DANCE, 1)
    waitmessage
    applymovement(1, moves(
        face_left
        face_up
        face_right
        face_down
        face_player
    ))
    waitmovement
    msgbox(format("Next up is the final path! It'll be different to all the earlier paths in that there won't be any birch bags or items lying around. And everyone you'll have to face will be extremely challenging. But I'm sure you can do it! I'm rooting for you!"))
    applymovement(1, moves(
        face_left
        face_up
        face_right
        face_down
        face_player
    ))
    waitmovement
    playmoncry(SPECIES_KYOGRE, CRY_MODE_ENCOUNTER)
    waitmoncry
    //TELEPORT TO NEXT STAGE
    special(WarpToNextAct)
    releaseall
}
