mapscripts Hoenn3_2_MapScripts {
}

script Hoenn3_2_KecShop_Sign {
    call(KecShop_Sign)
}

script Hoenn3_2_KecShop {
    call(KecShop)
}

script Hoenn3_2_KecShop_Shiny {
    call(KecShop_Shiny)
}

script Hoenn3_2_Skarmory{
	trainerbattle_single(TRAINER_SKARMORY, format("Do you remember Geronimo Stilton? The children's book series about the rat. I loved those books."), format("Good games."))
	msgbox(format("And can't forget the Thea sisters spinoff. I loves those too."), MSGBOX_AUTOCLOSE) 
	waitmessage
    end
}

script Hoenn3_2_Zangoose{
	trainerbattle_single(TRAINER_ZANGOOSE, format("Hi! I always keep a pack of wet wipes with me wherever I go."), format("You wiped the floor with me!"))
	msgbox(format("Wet wipes are so useful. I can clean my hands, my face, my phone..."), MSGBOX_AUTOCLOSE) 
	waitmessage
    end
}

script Hoenn3_2_Seviper{
	trainerbattle_single(TRAINER_SEVIPER, format("My favourite beatboxer? It's Hiss of course!"), format("Blaaargh"))
	msgbox(format("Bsss kla kla pow\pbuh kah mmka mmka buh kah mmka mmka."), MSGBOX_AUTOCLOSE) 
	waitmessage
    end
}

