script Hoenn3_2_Ninetales{
	trainerbattle_single(TRAINER_NINETALES, format("I watched all of Naruto recently cos all my friends said it was weird I hadn't watched it yet. It was pretty good."), format("You got me dattebayo."))
	msgbox(format("I watched Boruto too. I just loved the parts when all the kids were eating burgers and the samurai girl ate a mountain of chips. They're so precious."), MSGBOX_AUTOCLOSE) 
	waitmessage
    end
}

script Hoenn3_2_EventScript_BirchBag{
 
    lockall
    call(Act3BirchBag)
    
    removeobject(HOENN3_2_BIRCHBAG)
    setflag(FLAG_BIRCHBAG_3_2)
    

    waitmessage
    releaseall
    end
    
}

