script Hoenn3_2_EventScript_BirchBag{
 
    lockall
    call(Act3BirchBag)
    
    removeobject(HOENN3_2_BIRCHBAG)
    setflag(FLAG_BIRCHBAG_3_2)
    

    waitmessage
    releaseall
    end
    
}

