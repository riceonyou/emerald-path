mapscripts Hoenn3_2_MapScripts {
}

script Hoenn3_2_Skarmory{
	trainerbattle_single(TRAINER_SKARMORY, "test", "test")
	msgbox("test", MSGBOX_AUTOCLOSE) 
	waitmessage
    end
}

