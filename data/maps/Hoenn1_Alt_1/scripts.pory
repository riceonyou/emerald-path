mapscripts Hoenn1_Alt_1_MapScripts {
    MAP_SCRIPT_ON_FRAME_TABLE[ VAR_TEMP_1, 0: Hoenn1_Alt_1_ONFRAME]
}

script Hoenn1_Alt_1_ONFRAME {
    setvar(VAR_TEMP_1, 1)
    call(AfterWarpIntoNewAct)
}

script Hoenn1_Alt_1_EventScript_Boat{
 
    lock
    warp(MAP_HOENN1_ALT_2, 32, 7)
    waitstate
    release
    end
 
}

script Hoenn1_Alt_1_Sign {
    lockall

    msgbox("Talk to the boat to progress!")
    waitmessage

    releaseall
}

script Hoenn1_Alt_1_EventScript_Rattata{
	trainerbattle_single(TRAINER_RATTATA, format("Hey there.\p...What am I doing here in Hoenn?\lWell I was born here... My parents moved here from Kanto."), format("Yeah you beat me."))
	msgbox(format("Whatever."), MSGBOX_AUTOCLOSE) 
	waitmessage
    end
}

script Hoenn1_Alt_1_EventScript_BirchBag_1{
 
    lockall

    call(Act1BirchBag)
    
    removeobject(HOENN1_ALT_1_BIRCHBAG)
    setflag(FLAG_BIRCHBAG_1_1)
    

    waitmessage
    releaseall
    end
 
}

