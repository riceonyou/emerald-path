script Hoenn1_Alt_1_House_Itemball_2{
    lockall
    call(GiveCommonItem)
    removeobject(HOENN1_ALT_1_ITEM_2)
    setflag(FLAG_ITEM_1_2)
    releaseall
    end
}

script Hoenn1_Alt_1_House_Itemball_3{
