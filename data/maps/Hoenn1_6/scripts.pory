}

script Hoenn1_1_Itemball_4{
    lockall
    giveitem(ITEM_RARE_CANDY, 1)
    removeobject(HOENN1_4_ITEM)
    setflag(FLAG_ITEM_1_4)
    releaseall
    end
}

script Hoenn1_1_Itemball_5{
