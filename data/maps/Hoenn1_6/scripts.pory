script Hoenn1_6_EventScript_Rival{
    call(RivalFight1)
}

script Hoenn1_6_EventScript_Shroomish{
 
	trainerbattle_single(TRAINER_SHROOMISH, format("Hey."), format("Ggs."))
	msgbox(format("Oi. Did you just make fun of my monobrow?. How dare you >:("), MSGBOX_AUTOCLOSE) 
	waitmessage
    end
 
}

script Hoenn1_6_EventScript_Surskit{
 
	trainerbattle_single(TRAINER_SURSKIT, format("Did you know I secret oil from my feet to skate on water?"), format("Did you know that I am known to compete with Dewpider over food?"))
	msgbox(format("Did you know the antenna on my head secretes a thick, sugary syrup or a sweet scent?\n- Bulbapedia"), MSGBOX_AUTOCLOSE) 
	waitmessage
    end
 
}


script Hoenn1_8_EventScript_BirchBag{
 
    lockall
    call(Act1BirchBag)
    
    removeobject(HOENN1_8_BIRCHBAG)
    setflag(FLAG_BIRCHBAG_1_8)
    

    waitmessage
    releaseall
    end
 
}

script Hoenn1_7_EventScript_Skitty{
 
	trainerbattle_single(TRAINER_SKITTY, format("My favourite football player of all time? Personally it's Jay-Jay Okocha. He was so good that they named him twice."), format("I wish they would name me twice too."))
	msgbox(format("Hmm......\p If they did name me twice I would be called Skit-Skit Ty. How does that sound?"), MSGBOX_AUTOCLOSE) 
	waitmessage
    end
 
}

script Hoenn1_7_EventScript_Nincada{
 
	trainerbattle_single(TRAINER_NINCADA, format("My favourite football player of all time? I don't really watch soccer but Erling Haaland I guess. I saw some reels of him and I love his smooth, voluptuous hair."), format("What?\pWhat do you mean he shaved it off?"))
	msgbox(format("That's a shame. I'd like to have hair like him."), MSGBOX_AUTOCLOSE) 
	waitmessage
    end
 
}


