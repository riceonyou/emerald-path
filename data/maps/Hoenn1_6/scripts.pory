script Hoenn1_6_EventScript_Shroomish{
 
	trainerbattle_single(TRAINER_SHROOMISH, "test.", "test.")
	msgbox("test.", MSGBOX_AUTOCLOSE) 
	waitmessage
    end
 
}

script Hoenn1_6_EventScript_Surskit{
 
	trainerbattle_single(TRAINER_SURSKIT, "Hola. Me llamo Lotad.", "He perdido.")
	msgbox("test.", MSGBOX_AUTOCLOSE) 
	waitmessage
    end
 
}


script Hoenn1_8_EventScript_BirchBag{
 
    lockall
    playse(SE_CLICK)
    fadescreen(FADE_TO_BLACK)
    setvar(VAR_0x8000, 33)
    special(LoadBirchBagPoolById)
    special(ChooseBirchBagPokemonWeighted)
    waitstate
    
    removeobject(HOENN1_8_BIRCHBAG)
    setflag(FLAG_BIRCHBAG_1_8)
    playfanfare(MUS_EVOLVED)
    msgbox("You received a\n{STR_VAR_1}!")

    waitmessage
    releaseall
    end
 
}

