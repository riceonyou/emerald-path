mapscripts Hoenn1_3_MapScripts {
}

script Hoenn1_3_EventScript_Poochyena{
 
	trainerbattle_single(TRAINER_POOCHYENA, Poochyena_Intro, Poochyena_Outro)
	msgbox(PostBattle_Poochyena, MSGBOX_AUTOCLOSE) 
	waitmessage
    end
 
}
 
text Poochyena_Intro{
    "Ruff Ruff! Yena!"
}
 
text Poochyena_Outro{
    "whimpers"
}
 
text PostBattle_Poochyena{
    "Yena Poo Poo.\p...\p......\pI can speak English by the way."
}

script Hoenn1_3_EventScript_Lotad{
 
	trainerbattle_single(TRAINER_LOTAD, "Hola. Me llamo Lotad.", "He perdido.")
	msgbox("Que pasa amigo. No hablo English,\nlo siento.", MSGBOX_AUTOCLOSE) 
	waitmessage
    end
 
}

script Hoenn1_BirchBag_4{
 
    lockall
    playse(SE_CLICK)
    fadescreen(FADE_TO_BLACK)
    setvar(VAR_0x8000, 33)
    special(LoadBirchBagPoolById)
    special(ChooseBirchBagPokemonWeighted)
    waitstate
    
    removeobject(HOENN1_4_BIRCHBAG)
    setflag(FLAG_BIRCHBAG_1_4)
    msgbox("You received a\n{STR_VAR_1}!")

    waitmessage
    releaseall
    end
 
}

script Hoenn1_4_EventScript_Wingull{
 
	trainerbattle_single(TRAINER_WINGULL, "Howdy. I'm wingull. Let's battle!", "They should call me losegull, not\nwingull. Squawk :(")
	msgbox(format("Did you know you can nickname pokemon by pressing A on the summary page? I'm nicknaming myself Losegull right now."), MSGBOX_AUTOCLOSE)
	waitmessage
    end
 
}

script Hoenn1_4_EventScript_Seedot{
 
	trainerbattle_single(TRAINER_SEEDOT, format("Hi. I'm about to sow some of my seed inside of you >:)\p...Just kidding. I'm going to sow it on the ground. Because of my seed sower ability."), "Sorry for that joke earlier...")
	msgbox("I wonder what noise an acorn makes...", MSGBOX_AUTOCLOSE) 
	waitmessage
    end
 
}


