mapscripts Hoenn1_3_MapScripts {
}

script Hoenn1_3_EventScript_Poochyena{
 
	trainerbattle_single(TRAINER_POOCHYENA, Poochyena_Intro, Poochyena_Outro)
	msgbox(PostBattle_Poochyena, MSGBOX_AUTOCLOSE) 
	waitmessage
    end
 
}
 
text Poochyena_Intro{
    "Ruff Ruff! Yena!\pThere's no poke-centres around here,\nso when one of your pokemon faint,\lthey'll be gone for good! So be careful!"
}
 
text Poochyena_Outro{
    "Noo I lost!"
}
 
text PostBattle_Poochyena{
    "Ruff!."
}

script Hoenn1_3_EventScript_Lotad{
 
	trainerbattle_single(TRAINER_LOTAD, "Hola. Me llamo Lotad.", "He perdido.")
	msgbox("Que pasa amigo. No hablo English,\nlo siento.", MSGBOX_AUTOCLOSE) 
	waitmessage
    end
 
}

script Hoenn1_BirchBag_4{
 
    lockall
    call(Act1BirchBag)
    
    removeobject(HOENN1_4_BIRCHBAG)
    setflag(FLAG_BIRCHBAG_1_4)
    

    waitmessage
    releaseall
    end
 
}

script Hoenn1_4_EventScript_Wingull{
 
	trainerbattle_single(TRAINER_WINGULL, "Howdy. I'm wingull. Let's battle!", format("They should call me losegull, not\nwingull. Squawk. By the way, did you know you can nickname pokemon by pressing A on the summary page? I'm nicknaming myself Losegull right now."))
	msgbox(format("Did you know you can nickname pokemon by pressing A on the summary page? I'm nicknaming myself Losegull right now."), MSGBOX_AUTOCLOSE)
	waitmessage
    end
 
}

script Hoenn1_4_EventScript_Seedot{
 
	trainerbattle_single(TRAINER_SEEDOT, format("Hi. I'm about to sow some of my seed inside of you >:)\p...Just kidding. I'm going to sow it on the ground. Because of my seed sower ability."), format("Sorry for that joke earlier... By the way, if you already didn't know, you can access your PC through the start menu. If your party is full, any pokemon given to you will automatically go to there."))
	msgbox(format("You can access your PC through the start menu. If your party is full, pokemon given to you will automatically go to there."), MSGBOX_AUTOCLOSE) 
	waitmessage
    end
 
}


