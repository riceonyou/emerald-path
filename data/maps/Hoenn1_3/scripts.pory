mapscripts Hoenn1_3_MapScripts {
}

script Hoenn1_3_EventScript_Poochyena{
 
	trainerbattle_single(TRAINER_POOCHYENA, Poochyena_Intro, Poochyena_Outro)
	msgbox(PostBattle_Poochyena, MSGBOX_AUTOCLOSE) 
	waitmessage
    end
 
}
 
text Poochyena_Intro{
    "Ruff Ruff! Yena!"
}
 
text Poochyena_Outro{
    "whimpers"
}
 
text PostBattle_Poochyena{
    "Yena Poo Poo."
}

script Hoenn1_3_EventScript_Lotad{
 
	trainerbattle_single(TRAINER_LOTAD, "Hola. Me llamo Lotad.", "He perdido.")
	msgbox("Que pasa amigo.", MSGBOX_AUTOCLOSE) 
	waitmessage
    end
 
}

script Hoenn1_BirchBag_4{
 
    lockall
    playse(SE_CLICK)
    fadescreen(FADE_TO_BLACK)
    setvar(VAR_0x8000, 33)
    special(LoadBirchBagPoolById)
    special(ChooseBirchBagPokemonWeighted)
    waitstate
    
    removeobject(HOENN1_4_BIRCHBAG)
    setflag(FLAG_BIRCHBAG_1_4)
    playfanfare(MUS_EVOLVED)
    msgbox("You received a\n{STR_VAR_1}!")

    waitmessage
    releaseall
    end
 
}