mapscripts Hoenn1_2_MapScripts {
}

script Hoenn1_2_EventScript_Treecko{
 
	trainerbattle_single(TRAINER_HOENN1_2_TREECKO, Treecko_Intro, Treecko_Outro)
	msgbox(PostBattle_Treecko, MSGBOX_AUTOCLOSE) 
	waitmessage
    end
 
}
 
text Treecko_Intro{
    "Yo I'm Treecko. Grrr."
}
 
text Treecko_Outro{
    "Damn you got me."
}
 
text PostBattle_Treecko{
    "I'll get you next time."
}

script Hoenn1_2_EventScript_Zigzagoon{
 
	trainerbattle_single(TRAINER_HOENN1_2_ZIGZAGOON, Zigzagoon_Intro, Zigzagoon_Outro)
	msgbox(PostBattle_Zigzagoon, MSGBOX_AUTOCLOSE) 
	waitmessage
    end
 
}
 
text Zigzagoon_Intro{
    "I'm Zigzagoon. I like to go in zigzags."
}
 
text Zigzagoon_Outro{
    "Zagoon :("
}
 
text PostBattle_Zigzagoon{
    "Goon Goon!"
}