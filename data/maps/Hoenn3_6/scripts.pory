mapscripts Hoenn3_6_MapScripts {
}

script Hoenn3_6_EventScript_BirchBag{
 
    lockall
    playse(SE_CLICK)
    fadescreen(FADE_TO_BLACK)
    setvar(VAR_0x8000, 35)
    special(LoadBirchBagPoolById)
    special(ChooseBirchBagPokemonWeighted)
    waitstate
    
    removeobject(HOENN3_6_BIRCHBAG)
    setflag(FLAG_BIRCHBAG_3_6)
    playfanfare(MUS_EVOLVED)
    msgbox("You received a\n{STR_VAR_1}!")

    waitmessage
    releaseall
    end
    
}