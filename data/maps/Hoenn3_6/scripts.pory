mapscripts Hoenn3_6_MapScripts {
}

script Hoenn3_9_EventScript_BirchBag{
 
    lockall
    call(Act3BirchBag)
    
    removeobject(HOENN3_9_BIRCHBAG)
    setflag(FLAG_BIRCHBAG_3_9)
    playfanfare(MUS_EVOLVED)
    

    waitmessage
    releaseall
    end
    
}

