mapscripts ANCIENT_LUGIA_MapScripts {
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE[ VAR_TEMP_1, 0: ANCIENT_LUGIA_ONWARP]
}
script ANCIENT_LUGIA_ONWARP {
    setvar(VAR_TEMP_1, 1)
    turnobject(LOCALID_PLAYER, DIR_NORTH)
}

script ANCIENT_LUGIA_EventScript_TalkToLugia{
    lockall
    faceplayer
    msgbox(format("Oh, hey...\pUmm...\pCould you talk to me from below the altar? It's a lot cooler that way, no?"))
    waitmessage
    applymovement(1, moves(
        face_down
    ))
    waitmovement
    releaseall
}

script ANCIENT_LUGIA_EventScript_Sign{
    lockall
    //faceplayer
    //GIVE ANCIENT REWARD
    msgbox("Heya!\nGood job on beating the first path!\lI've got a bunch of goodies to give you!\lHere's a water pokemon!")
    waitmessage
    fadescreen(FADE_TO_BLACK)
    setvar(VAR_0x8000, 38)
    special(LoadBirchBagPoolById)
    special(ChooseBirchBagPokemonWeighted)
    waitstate
    
    msgbox("And a Rain Dance TM!")
    giveitem(ITEM_TM_RAIN_DANCE, 1)
    waitmessage
    msgbox("And a Phione Egg!\lThe egg will hatch into a phione\lafter you complete the next act!\lPhione is a great rain pokemon!")
    giveitem(ITEM_PHIONE_EGG_CHARM, 1)
    waitmessage
    playfanfare(MUS_OBTAIN_ITEM)
    msgbox("The level cap has been raised to 30")
    msgbox("That's all from me!\lNow lets get ya to the next path!")
    //TELEPORT TO NEXT STAGE
    special(WarpToNextAct)
    releaseall
}