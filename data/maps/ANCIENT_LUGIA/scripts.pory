mapscripts ANCIENT_LUGIA_MapScripts {
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE[ VAR_TEMP_1, 0: ANCIENT_LUGIA_ONWARP]
}
script ANCIENT_LUGIA_ONWARP {
    setvar(VAR_TEMP_1, 1)
    turnobject(LOCALID_PLAYER, DIR_NORTH)
}

script ANCIENT_LUGIA_EventScript_TalkToLugia{
    lockall
    faceplayer
    msgbox(format("Oh, hey...\pUmm......\pCould you talk to me from below the altar? It's a lot cooler that way, no?"))
    waitmessage
    applymovement(1, moves(
        face_down
    ))
    waitmovement
    releaseall
}

script ANCIENT_LUGIA_EventScript_Sign{
    lockall
    //GIVE ANCIENT REWARD
    playmoncry(SPECIES_LUGIA, CRY_MODE_ENCOUNTER)
    waitmoncry
    msgbox(format("Good job on defeating the first path! Please let on of my flying pokemon friends join you!"))
    waitmessage
    applymovement(1, moves(
        walk_in_place_down * 2
    ))
    waitmovement
    fadescreen(FADE_TO_BLACK)
    setvar(VAR_0x8000, 38)
    special(LoadBirchBagPoolById)
    special(ChooseBirchBagPokemonWeighted)
    waitstate
    playfanfare(MUS_EVOLVED)
	msgbox("You received a\n{STR_VAR_1}!")
    msgbox(format("And have one of my moulten back plates!\nWith that, now your pokemon won't take bonus super-effective damage on the first turn of the battle!."))
    waitmessage
    applymovement(1, moves(
        walk_in_place_down * 2
    ))
    waitmovement
    giveitem(ITEM_LUGIA_PLATE_CHARM, 1)
    waitmessage

    msgbox("I hope the rest of your journey\ngoes well!")
    //TELEPORT TO NEXT STAGE
    special(WarpToNextAct)
    releaseall
}