mapscripts ANCIENT_HOOH_MapScripts {
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE[ VAR_TEMP_1, 0: ANCIENT_HOOH_ONWARP]
}
script ANCIENT_HOOH_ONWARP {
    setvar(VAR_TEMP_1, 1)
    turnobject(LOCALID_PLAYER, DIR_NORTH)
}

script ANCIENT_HOOH_EventScript_TalkToHOOH{
    lockall
    faceplayer
    msgbox(format("Ermm...\pIt's a bit awkward talking you from there. How about you talk to me from the below the altar?"))
    waitmessage
    applymovement(1, moves(
        face_down
    ))
    waitmovement
    releaseall
}

script ANCIENT_HOOH_EventScript_Sign{
    lockall
    //GIVE ANCIENT REWARD
    playmoncry(SPECIES_HO_OH, CRY_MODE_ENCOUNTER)
    waitmoncry
    msgbox(format("You've done well to complete the first path. Please take a pokemon with you."))
    waitmessage
    applymovement(1, moves(
        walk_in_place_down * 2
    ))
    waitmovement
    fadescreen(FADE_TO_BLACK)
    setvar(VAR_0x8000, 37)
    special(LoadBirchBagPoolById)
    special(ChooseBirchBagPokemonWeighted)
    waitstate
    playfanfare(MUS_EVOLVED)
	msgbox("You received a\n{STR_VAR_1}!")
    msgbox(format("And a special gift. A freshly plucked feather of my own. When you lose a fight while you have this, instead of losing the run, you will get another chance."))
    waitmessage
    applymovement(1, moves(
        walk_in_place_down * 2
    ))
    waitmovement
    giveitem(ITEM_HOOH_FEATHER_CHARM, 1)
    waitmessage

    msgbox("I wish you well on your journey.")
    //TELEPORT TO NEXT STAGE
    special(WarpToNextAct)
    releaseall
}