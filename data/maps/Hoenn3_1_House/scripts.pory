mapscripts Hoenn3_1_House_MapScripts {
}

script Hoenn3_Itemball_1{
    lockall
    call(GiveCommonItem)
    removeobject(Hoenn3_Ball1)
    setflag(FLAG_ITEM_3_1)
    releaseall
    end
}

