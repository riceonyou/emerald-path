mapscripts Hoenn4_5_MapScripts {
}

script Hoenn4_5_Farigiraf{
	trainerbattle_single(TRAINER_FARIGIRAF, format("test"), format("test"))
	msgbox(format("test"), MSGBOX_AUTOCLOSE) 
	waitmessage
    end
}

