script Hoenn4_5_Latios{
	trainerbattle_double(TRAINER_LATIOS_LATIAS, "test", "test", Hoenn4_5_Latios_Latias_Defeated)
	msgbox(format("test"), MSGBOX_AUTOCLOSE) 
	waitmessage
    end
}

