mapscripts Hoenn1_8_MapScripts {
}

script Hoenn1_8_EventScript_Taillow{
 
	trainerbattle_single(TRAINER_TAILLOW, format("Welcome to the gym! You'll always find us at the end of a path. Once you beat the leader at the end of the gym, you can teleport to the next area by talking to abra! Now let's fight!"), "Aaaa you got me!")
	msgbox("Good luck with the rest of the run.", MSGBOX_AUTOCLOSE) 
	waitmessage
    end
 
}

script Hoenn1_8_EventScript_Whismur{
 
	trainerbattle_single(TRAINER_WHISMUR, format("Psst. Did you know that almost all pokemon in this game evolve at either level 16 or 32? Or both if they can evolve twice."), format("I can't wait to evolve into a loudred. But this level cap is making it hard..."))
	msgbox(format("Mumble mumble mumble...\pMaybe if I had some rare candies... Then I wouldn't have to go to the next path to evolve...\pMumble mumble..."), MSGBOX_AUTOCLOSE) 
	waitmessage
    end
 
}

script Hoenn1_8_EventScript_Nosepass{
	trainerbattle_single(TRAINER_LEADER_NOSEPASS, format("Hello. I am the leader of this gym. We tend to have full teams of 6 pokemon. I hope you are prepared."), format("Congratulations. You have defeated me. Talk to the Abra to continue."), Hoenn1_8_EventScript_Nosepass_Defeated)
	msgbox(format("Talk to the Abra to continue. Before you head to the next path though, you will be teleported to a location of a legendary pokemon with special rewards for you."), MSGBOX_AUTOCLOSE) 
	waitmessage
    end
}

script Hoenn1_8_EventScript_Nosepass_Defeated{
	setflag(FLAG_DEFEATED_PATH_LEADER)
	end
}

script EventScript_AbraTeleport1{
	call(AbraTeleport)
}